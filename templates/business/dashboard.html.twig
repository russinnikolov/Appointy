{% extends 'base.html.twig' %}
{% block title %}{{ organization.name }} — {{ 'nav.dashboard'|trans }}{% endblock %}

{% block head %}
<style>
/* ── Calendar ── */
.cal-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.cal-table { border-collapse: collapse; min-width: 700px; table-layout: fixed; }
.cal-table th, .cal-table td { border: 1px solid #f3f4f6; }

.cal-time-th { width: 58px; background: #fff; }
.cal-day-th  { text-align: center; padding: 10px 4px 8px; background: #f9fafb; min-width: 110px; }
.cal-day-th .d-name { font-size: .63rem; font-weight: 700; text-transform: uppercase; color: #9ca3af; letter-spacing: .05em; }
.cal-day-th .d-num  { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .9rem; font-weight: 700; color: #374151; margin: 3px auto 0; }
.cal-day-th.today   { background: #f5f3ff; border-bottom: 2px solid #6366f1; }
.cal-day-th.today .d-num { background: #6366f1; color: #fff; }

.cal-time-td { font-size: .7rem; color: #9ca3af; text-align: right; padding: 0 8px; white-space: nowrap; vertical-align: top; padding-top: 6px; width: 58px; background: #fff; }
.cal-day-td  { vertical-align: top; padding: 3px; min-height: 52px; }
.cal-day-td.closed { background: repeating-linear-gradient(135deg, #f9fafb 0, #f9fafb 4px, #fff 4px, #fff 12px); }

.cal-appt { border-radius: 6px; padding: 4px 7px; font-size: .75rem; font-weight: 600; cursor: pointer; margin-bottom: 2px; line-height: 1.3; transition: opacity .1s, transform .1s; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cal-appt:hover { opacity: .82; transform: translateY(-1px); }
.cal-appt.pending   { background: #fef3c7; color: #92400e; border-left: 3px solid #f59e0b; }
.cal-appt.confirmed { background: #d1fae5; color: #065f46; border-left: 3px solid #10b981; }
.cal-appt.cancelled { background: #f3f4f6; color: #9ca3af; border-left: 3px solid #d1d5db; opacity: .6; }

.cal-day-td.blocked { background: repeating-linear-gradient(135deg, #fee2e2 0, #fee2e2 4px, #fff 4px, #fff 12px); }
.block-label { font-size: .65rem; color: #991b1b; font-weight: 600; padding: 2px 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* week nav */
.week-nav { display: flex; align-items: center; gap: 10px; }
.week-nav-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid #e5e7eb; background: #f9fafb; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #6b7280; transition: .15s; }
.week-nav-btn:hover  { background: #ede9fe; border-color: #6366f1; color: #6366f1; }
.week-nav-btn.disabled { opacity: .35; pointer-events: none; }
</style>
{% endblock %}

{% block body %}
<div class="mb-4">
    <h4 class="fw-bold mb-0">{{ organization.name }}</h4>
    <p class="text-muted small mb-0">
        {% if organization.category %}{{ ('category.' ~ organization.category)|trans }}{% endif %}{% if organization.category and organization.address %} · {% endif %}{{ organization.address }}
    </p>
</div>

<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="card p-3 text-center">
            <div class="fw-bold fs-3 mb-0" style="color:#92400e">{{ counts.pending }}</div>
            <div class="text-muted small">{{ 'business.stats.pending'|trans }}</div>
        </div>
    </div>
    <div class="col-4">
        <div class="card p-3 text-center">
            <div class="fw-bold fs-3 mb-0" style="color:#065f46">{{ counts.confirmed }}</div>
            <div class="text-muted small">{{ 'business.stats.confirmed'|trans }}</div>
        </div>
    </div>
    <div class="col-4">
        <div class="card p-3 text-center">
            <div class="fw-bold fs-3 mb-0" style="color:#991b1b">{{ counts.cancelled }}</div>
            <div class="text-muted small">{{ 'business.stats.cancelled'|trans }}</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end mb-3">
    <a href="{{ path('business_appointments_list') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-list-ul me-1"></i>{{ 'appt.view_all'|trans }}
    </a>
</div>

{# ── Main tabs ──────────────────────────────────────────────────── #}
<ul class="nav nav-tabs mb-3" id="dashTabs">
    <li class="nav-item">
        <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-calendar">
            <i class="bi bi-calendar3 me-1"></i>{{ 'dashboard.tab_calendar'|trans }}
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#tab-reports">
            <i class="bi bi-bar-chart-line me-1"></i>{{ 'dashboard.tab_reports'|trans }}
        </button>
    </li>
</ul>

<div class="tab-content">

{# ── Calendar tab ───────────────────────────────────────────────── #}
<div class="tab-pane fade show active" id="tab-calendar">

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="week-nav">
        <button class="week-nav-btn" id="prevWeek"><i class="bi bi-chevron-left"></i></button>
        <span class="fw-semibold" id="weekLabel" style="min-width:160px;text-align:center"></span>
        <button class="week-nav-btn" id="nextWeek"><i class="bi bi-chevron-right"></i></button>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary" id="todayBtn">{{ 'common.today'|trans }}</button>
        <button class="btn btn-sm btn-outline-secondary" id="collapseBtn">
            <i class="bi bi-arrows-collapse me-1"></i><span id="collapseBtnLabel">{{ 'dashboard.collapse'|trans }}</span>
        </button>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary filter-btn active" data-filter="all">{{ 'common.all'|trans }}</button>
            <button type="button" class="btn btn-outline-warning filter-btn" data-filter="pending">{{ 'status.pending'|trans }}</button>
            <button type="button" class="btn btn-outline-success filter-btn" data-filter="confirmed">{{ 'status.confirmed'|trans }}</button>
            <button type="button" class="btn btn-outline-secondary filter-btn" data-filter="cancelled">{{ 'status.cancelled'|trans }}</button>
        </div>
    </div>
</div>

<div class="cal-wrap card p-0" style="overflow:hidden">
    <div id="calInner" class="cal-wrap" style="padding:0"></div>
</div>

</div>{# /tab-calendar #}

{# ── Reports tab ────────────────────────────────────────────────── #}
<div class="tab-pane fade" id="tab-reports">
<div class="row g-4">

    {# Report 1 — Custom range #}
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h6 class="fw-bold mb-1"><i class="bi bi-funnel me-2 text-primary"></i>{{ 'report.custom_title'|trans }}</h6>
            <p class="text-muted small mb-3">{{ 'report.custom_desc'|trans }}</p>

            <form id="reportCustomForm" novalidate>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">{{ 'report.date_from'|trans }} <span class="text-danger">*</span></label>
                        <input type="date" id="cr_from" class="form-control" required>
                        <div class="invalid-feedback">{{ 'report.required_field'|trans }}</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">{{ 'report.date_to'|trans }} <span class="text-danger">*</span></label>
                        <input type="date" id="cr_to" class="form-control" required>
                        <div class="invalid-feedback">{{ 'report.required_field'|trans }}</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">{{ 'report.status'|trans }}</label>
                    <select id="cr_status" class="form-select">
                        <option value="">{{ 'report.all_statuses'|trans }}</option>
                        <option value="pending">{{ 'status.pending'|trans }}</option>
                        <option value="confirmed">{{ 'status.confirmed'|trans }}</option>
                        <option value="cancelled">{{ 'status.cancelled'|trans }}</option>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">{{ 'report.employee'|trans }}</label>
                    <select id="cr_employee" class="form-select">
                        <option value="">{{ 'report.all_employees'|trans }}</option>
                        {% for emp in employees %}
                            <option value="{{ emp.id }}">{{ emp.name }}{% if emp.role %} — {{ emp.role }}{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <div id="cr_error" class="alert alert-danger py-2 small d-none"></div>
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-download me-1"></i>{{ 'report.execute'|trans }}
                </button>
            </form>
        </div>
    </div>

    {# Report 2 — Monthly #}
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h6 class="fw-bold mb-1"><i class="bi bi-calendar-month me-2 text-success"></i>{{ 'report.monthly_title'|trans }}</h6>
            <p class="text-muted small mb-3">{{ 'report.monthly_desc'|trans }}</p>

            <form id="reportMonthlyForm" novalidate>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">{{ 'report.month'|trans }} <span class="text-danger">*</span></label>
                    <input type="month" id="mr_month" class="form-control" required>
                    <div class="invalid-feedback">{{ 'report.required_field'|trans }}</div>
                </div>
                <div id="mr_error" class="alert alert-danger py-2 small d-none"></div>
                <button type="submit" class="btn btn-success w-100 fw-semibold mt-auto">
                    <i class="bi bi-download me-1"></i>{{ 'report.execute'|trans }}
                </button>
            </form>
        </div>
    </div>

</div>
</div>{# /tab-reports #}

</div>{# /tab-content #}

<div class="modal fade" id="apptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-1">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="modalName"></h5>
                    <div class="text-muted small" id="modalMeta"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <div id="modalBody"></div>
            </div>
            <div class="modal-footer border-0 pt-0" id="modalFooter"></div>
        </div>
    </div>
</div>

<form method="post" id="confirmForm" style="display:none">
    <input type="hidden" name="_confirm"    value="1">
    <input type="hidden" name="force"       id="confirmForce"      value="0">
    <input type="hidden" name="employee_id" id="confirmEmployeeId" value="">
</form>
<form method="post" id="cancelForm" style="display:none">
    <input type="hidden" name="cancellation_note" id="cancelNote">
    <input type="hidden" name="employee_id"       id="cancelEmployeeId" value="">
</form>
{% endblock %}

{% block scripts %}
{% set dayAbbr = [
    'cal.day.0'|trans, 'cal.day.1'|trans, 'cal.day.2'|trans,
    'cal.day.3'|trans, 'cal.day.4'|trans, 'cal.day.5'|trans, 'cal.day.6'|trans
] %}
{% set monthNames = [
    'cal.month.0'|trans, 'cal.month.1'|trans, 'cal.month.2'|trans,
    'cal.month.3'|trans, 'cal.month.4'|trans, 'cal.month.5'|trans,
    'cal.month.6'|trans, 'cal.month.7'|trans, 'cal.month.8'|trans,
    'cal.month.9'|trans, 'cal.month.10'|trans, 'cal.month.11'|trans
] %}
<script>
const appointments   = {{ appointments_json|raw }};
const blockedPeriods = {{ blocked_json|raw }};
const workingHours   = {{ organization.workingHours|json_encode|raw }};
const timeStep       = {{ organization.timeStep }};
const orgCapacity    = {{ org_capacity }};
const orgEmployees   = {{ org_employees_json|raw }};

const confirmUrl  = id => `{{ path('business_confirm',    {id: '__ID__'}) }}`.replace('__ID__', id);
const cancelUrl   = id => `{{ path('business_cancel',     {id: '__ID__'}) }}`.replace('__ID__', id);
const durationUrl = id => `{{ path('business_set_duration',{id: '__ID__'}) }}`.replace('__ID__', id);

const DAY_ABBR   = {{ dayAbbr|json_encode|raw }};
const DAY_NAMES  = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];
const MONTH_NAMES = {{ monthNames|json_encode|raw }};

const icalUrlTpl = `{{ path('appointment_ical', {id: '__ID__'}) }}`;
const icalUrl    = id => icalUrlTpl.replace('__ID__', id);

const T = {
    pending:              {{ 'status.pending'|trans|json_encode|raw }},
    confirmed:            {{ 'status.confirmed'|trans|json_encode|raw }},
    cancelled:            {{ 'status.cancelled'|trans|json_encode|raw }},
    guest:                {{ 'status.guest'|trans|json_encode|raw }},
    close:                {{ 'common.close'|trans|json_encode|raw }},
    confirm:              {{ 'common.confirm'|trans|json_encode|raw }},
    cancel:               {{ 'common.cancel'|trans|json_encode|raw }},
    cancelTitle:          {{ 'business.cancel.title'|trans|json_encode|raw }},
    cancelNoteLabel:      {{ 'business.cancel.note_label'|trans|json_encode|raw }},
    cancelNotePlaceholder:{{ 'business.cancel.note_placeholder'|trans|json_encode|raw }},
    cancelYes:            {{ 'business.cancel.yes'|trans|json_encode|raw }},
    cancelKeep:           {{ 'business.cancel.keep'|trans|json_encode|raw }},
    noWorkingHours:       {{ 'business.no_working_hours'|trans|json_encode|raw }},
    setWorkingHours:      {{ 'business.set_working_hours'|trans|json_encode|raw }},
    noApptsWeek:          {{ 'business.no_appts_week'|trans|json_encode|raw }},
    addToCalendar:        {{ 'cal.add_to_calendar'|trans|json_encode|raw }},
    addIcal:              {{ 'cal.add_ical'|trans|json_encode|raw }},
    addGoogle:            {{ 'cal.add_google'|trans|json_encode|raw }},
    collapse:             {{ 'dashboard.collapse'|trans|json_encode|raw }},
    expand:               {{ 'dashboard.expand'|trans|json_encode|raw }},
    duration:             {{ 'appt.duration'|trans|json_encode|raw }},
    durationMin:          {{ 'appt.duration_min'|trans|json_encode|raw }},
    durationDefault:      {{ 'appt.duration_default'|trans|json_encode|raw }},
    conflictTitle:        {{ 'appt.conflict_title'|trans|json_encode|raw }},
    conflictText:         {{ 'appt.conflict_text'|trans|json_encode|raw }},
    conflictConfirm:      {{ 'appt.conflict_confirm'|trans|json_encode|raw }},
    capacityTitle:        {{ 'appt.capacity_title'|trans|json_encode|raw }},
    capacityText:         {{ 'appt.capacity_text'|trans|json_encode|raw }},
    capacityAccept:       {{ 'appt.capacity_accept'|trans|json_encode|raw }},
    capacityDecline:      {{ 'appt.capacity_decline'|trans|json_encode|raw }},
    anyEmployee:          {{ 'book.any_employee'|trans|json_encode|raw }},
    assignEmployee:       {{ 'appt.assign_employee'|trans|json_encode|raw }},
};
let collapseEmpty = false;

let windowStart  = startOfWeek();
let activeFilter = 'all';

function startOfToday() { const d = new Date(); d.setHours(0,0,0,0); return d; }
function startOfWeek()  {
    const d = startOfToday();
    const diff = d.getDay() === 0 ? -6 : 1 - d.getDay();
    d.setDate(d.getDate() + diff);
    return d;
}
function addDays(d, n)  { const r = new Date(d); r.setDate(r.getDate() + n); return r; }
function isoDate(d)     { return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); }
const toMin = t => { const [h,m] = t.split(':').map(Number); return h*60+m; };
const toStr = m => String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0');

function getBlockInfo(dateStr, tsMin) {
    for (const b of blockedPeriods) {
        if (b.date !== dateStr || b.employee_id !== null) continue;
        const s = toMin(b.start), e = toMin(b.end);
        if (tsMin < s || tsMin >= e) continue;
        const firstSlot = Math.ceil(s / timeStep) * timeStep;
        const lastSlot  = Math.floor((e - 1) / timeStep) * timeStep;
        const mid = firstSlot + Math.floor((lastSlot - firstSlot) / timeStep / 2) * timeStep;
        return { label: tsMin === mid ? (b.label || '🚫') : null };
    }
    return null;
}

function visibleAppointments() {
    if (activeFilter === 'all') return appointments;
    return appointments.filter(a => a.status === activeFilter);
}

function renderCalendar() {
    const today = startOfToday();
    const days  = Array.from({length: 7}, (_, i) => addDays(windowStart, i));

    const months = new Set(days.map(d => MONTH_NAMES[d.getMonth()] + ' ' + d.getFullYear()));
    document.getElementById('weekLabel').textContent = [...months].join(' / ');
    document.getElementById('prevWeek').classList.toggle('disabled', windowStart <= today);

    let minOpen = Infinity, maxClose = -Infinity;
    Object.values(workingHours).forEach(cfg => {
        if (!cfg || !cfg.enabled) return;
        minOpen  = Math.min(minOpen,  toMin(cfg.open));
        maxClose = Math.max(maxClose, toMin(cfg.close));
    });

    const appts = visibleAppointments();
    const idx = {};
    appts.forEach(a => {
        (idx[a.date] ??= {})[a.time] ??= [];
        idx[a.date][a.time].push(a);
    });

    // Pre-compute rowspans (non-cancelled appts with duration > 1 slot span multiple rows)
    const rsMap   = {}; // { dateStr: { timeStr: rowspan } }
    const covered = {}; // { dateStr: Set<timeStr> } — cells swallowed by a rowspan above
    appts.forEach(a => {
        if (a.status === 'cancelled') return;
        const rs = Math.max(1, Math.ceil((a.duration_minutes || timeStep) / timeStep));
        if (rs <= 1) return;
        const existing = rsMap[a.date]?.[a.time] || 1;
        (rsMap[a.date] ??= {})[a.time] = Math.max(existing, rs);
    });
    Object.entries(rsMap).forEach(([date, times]) => {
        Object.entries(times).forEach(([time, rs]) => {
            const startMin = toMin(time);
            (covered[date] ??= new Set());
            for (let i = 1; i < rs; i++) covered[date].add(toStr(startMin + i * timeStep));
        });
    });

    let html = '<table class="cal-table w-100"><thead><tr>';
    html += '<th class="cal-time-th"></th>';
    days.forEach(d => {
        const isToday  = isoDate(d) === isoDate(today);
        const dayName  = DAY_NAMES[d.getDay()];
        const cfg      = workingHours[dayName];
        const isClosed = !cfg || !cfg.enabled;
        html += `<th class="cal-day-th${isToday ? ' today' : ''}${isClosed ? ' closed' : ''}">
            <div class="d-name">${DAY_ABBR[d.getDay()]}</div>
            <div class="d-num">${d.getDate()}</div>
        </th>`;
    });
    html += '</tr></thead><tbody>';

    if (minOpen === Infinity) {
        const whUrl = {{ path('business_working_hours')|json_encode|raw }};
        html += `<tr><td colspan="8" class="text-center text-muted py-5 small">
            <i class="bi bi-clock me-1"></i>${T.noWorkingHours}
            <a href="${whUrl}" class="ms-1">${T.setWorkingHours}</a>
        </td></tr>`;
    } else {
        for (let t = minOpen; t < maxClose; t += timeStep) {
            const ts = toStr(t);
            if (collapseEmpty && !days.some(d => (idx[isoDate(d)]?.[ts] || []).length > 0)) continue;
            html += '<tr>';
            html += `<td class="cal-time-td">${ts}</td>`;
            days.forEach(d => {
                const dateStr  = isoDate(d);
                // Skip cells consumed by a rowspan from an earlier slot
                if (covered[dateStr]?.has(ts)) return;

                const dayName   = DAY_NAMES[d.getDay()];
                const cfg       = workingHours[dayName];
                const isClosed  = !cfg || !cfg.enabled || t < toMin(cfg.open) || t >= toMin(cfg.close);
                const blockInfo = getBlockInfo(dateStr, t);
                const cell      = idx[dateStr]?.[ts] || [];
                const rs        = rsMap[dateStr]?.[ts] || 1;
                const rsAttr    = rs > 1 ? ` rowspan="${rs}"` : '';

                let pills = '';
                if (blockInfo?.label) pills += `<div class="block-label" title="${blockInfo.label}">${blockInfo.label}</div>`;
                cell.forEach(a => {
                    const dur      = a.duration_minutes || timeStep;
                    const durLabel = dur !== timeStep
                        ? ` <span style="opacity:.7;font-size:.65rem">${dur}${T.durationMin}</span>` : '';
                    pills += `<div class="cal-appt ${a.status}" data-dur="${dur}" onclick="openModal(${a.id})" title="${a.booker_name}">${a.booker_name}${durLabel}</div>`;
                });
                const classes = ['cal-day-td', isClosed ? 'closed' : '', blockInfo ? 'blocked' : ''].filter(Boolean).join(' ');
                html += `<td class="${classes}"${rsAttr}>${pills}</td>`;
            });
            html += '</tr>';
        }
    }

    html += '</tbody></table>';
    document.getElementById('calInner').innerHTML = html;

    // Stretch spanning pills to fill their rowspan height
    requestAnimationFrame(() => {
        const refRow = document.querySelector('.cal-time-td');
        if (!refRow) return;
        const rowH = refRow.offsetHeight;
        document.querySelectorAll('.cal-appt[data-dur]').forEach(pill => {
            const slots = Math.ceil(+pill.dataset.dur / timeStep);
            if (slots <= 1) return;
            pill.style.minHeight   = (slots * rowH - 8) + 'px';
            pill.style.whiteSpace  = 'normal';
            pill.style.overflow    = 'hidden';
            pill.style.alignItems  = 'flex-start';
        });
    });
}

function openModal(id) {
    const a = appointments.find(x => x.id === id);
    if (!a) return;

    const statusLabel = { pending: T.pending, confirmed: T.confirmed, cancelled: T.cancelled };
    const statusClass = { pending: 'warning', confirmed: 'success', cancelled: 'secondary' };

    document.getElementById('modalName').innerHTML =
        a.booker_name + (a.guest ? ` <span class="badge bg-light text-secondary border ms-1" style="font-size:.65rem">${T.guest}</span>` : '');
    document.getElementById('modalMeta').textContent = a.date + ' · ' + a.time;

    const messagingCfg = {
        whatsapp: { icon: 'bi-whatsapp',  color: '#25D366', label: 'WhatsApp', url: p => `https://wa.me/${p.replace(/\D/g,'')}` },
        telegram: { icon: 'bi-telegram',  color: '#229ED9', label: 'Telegram', url: p => `tg://resolve?phone=+${p.replace(/\D/g,'')}` },
        viber:    { icon: 'bi-phone',     color: '#7360f2', label: 'Viber',    url: p => `viber://chat?number=${encodeURIComponent(p)}` },
        sms:      { icon: 'bi-chat-dots', color: '#6b7280', label: 'SMS',      url: p => `sms:${p}` },
    };

    let body = `<div class="d-flex flex-column gap-2 small">`;
    if (a.booker_phone) {
        const msgIcons = (a.messaging_apps || []).map(app => {
            const cfg = messagingCfg[app];
            if (!cfg) return '';
            return `<a href="${cfg.url(a.booker_phone)}" target="_blank" rel="noopener"
                       title="${cfg.label}" class="text-decoration-none"
                       style="font-size:1.4rem;line-height:1;color:${cfg.color}">
                       <i class="bi ${cfg.icon}"></i>
                    </a>`;
        }).join('');
        body += `<div class="d-flex align-items-center gap-2">
            <i class="bi bi-telephone text-muted"></i>
            <span>${a.booker_phone}</span>
            ${msgIcons ? `<span class="d-flex gap-2 ms-1">${msgIcons}</span>` : ''}
        </div>`;
    }
    // ── Employee row — always visible ─────────────────────────────
    body += `<div class="d-flex align-items-center gap-2">
        <i class="bi bi-person-badge text-muted flex-shrink-0"></i>`;
    if (a.employee_name) {
        body += `<span><strong>${a.employee_name}</strong>`;
        if (a.employee_role) body += ` <span class="text-muted">(${a.employee_role})</span>`;
        body += `</span>`;
    } else if (a.status !== 'cancelled' && orgEmployees.length > 0) {
        // No employee assigned and appointment is still actionable — show selector
        const opts = orgEmployees.map(e =>
            `<option value="${e.id}">${e.name}${e.role ? ' — ' + e.role : ''}</option>`
        ).join('');
        body += `<select id="modalEmployeeSelect" class="form-select form-select-sm flex-grow-1" style="max-width:220px">
            <option value="">${T.anyEmployee}</option>
            ${opts}
        </select>`;
    } else {
        body += `<span class="text-muted fst-italic">${T.anyEmployee}</span>`;
    }
    body += `</div>`;
    if (a.notes) body += `<div><i class="bi bi-chat-left-text me-2 text-muted"></i>${a.notes}</div>`;
    body += `<div><i class="bi bi-circle-fill me-2" style="color:var(--bs-${statusClass[a.status]});font-size:.5rem;vertical-align:middle"></i>
        <span class="badge bg-${statusClass[a.status]}-subtle text-${statusClass[a.status]}-emphasis border border-${statusClass[a.status]}-subtle">${statusLabel[a.status]}</span></div>`;
    if (a.cancel_note) body += `<div class="text-muted fst-italic"><i class="bi bi-info-circle me-2"></i>${a.cancel_note}</div>`;

    if (a.status !== 'cancelled') {
        const cur    = a.duration_minutes || timeStep;
        const maxDur = getMaxDurationMins(a);
        const opts   = [];
        for (let m = timeStep; m <= maxDur; m += timeStep) {
            opts.push(`<option value="${m}" ${m === cur ? 'selected' : ''}>${m} ${T.durationMin}</option>`);
        }
        if (cur > maxDur) opts.push(`<option value="${cur}" selected>${cur} ${T.durationMin}</option>`);
        body += `<div class="d-flex align-items-center gap-2 mt-2 pt-2 border-top">
            <i class="bi bi-hourglass-split text-muted" style="font-size:.85rem"></i>
            <span class="small">${T.duration}:</span>
            <select id="durationSelect" class="form-select form-select-sm" style="width:auto" onchange="onDurationChange(${a.id}, this.value)">
                ${opts.join('')}
            </select>
            <span class="text-muted small" id="durationSaved" style="display:none">✓</span>
        </div>`;
    }

    body += `</div>`;
    document.getElementById('modalBody').innerHTML = body;

    let footer = `<button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">${T.close}</button>`;
    if (a.status === 'pending') {
        footer += `<button type="button" class="btn btn-success btn-sm" onclick="doConfirm(${a.id})">
            <i class="bi bi-check-lg me-1"></i>${T.confirm}</button>`;
        footer += `<button type="button" class="btn btn-danger btn-sm" onclick="doCancel(${a.id},'${a.booker_name.replace(/'/g,"\\'")}',0)">
            <i class="bi bi-x-lg me-1"></i>${T.cancel}</button>`;
    } else if (a.status === 'confirmed') {
        footer += buildCalendarBtn(a);
        footer += `<button type="button" class="btn btn-danger btn-sm" onclick="doCancel(${a.id},'${a.booker_name.replace(/'/g,"\\'")}',1)">
            <i class="bi bi-x-lg me-1"></i>${T.cancel}</button>`;
    }
    document.getElementById('modalFooter').innerHTML = footer;

    bootstrap.Modal.getOrCreateInstance(document.getElementById('apptModal')).show();
}

function buildCalendarBtn(a) {
    return `<button type="button" class="btn btn-outline-success btn-sm" onclick="addToCalendar(${a.id})">
        <i class="bi bi-calendar-plus me-1"></i>${T.addToCalendar}
    </button>`;
}

function addToCalendar(id) {
    const a = appointments.find(x => x.id === id);
    if (!a) return;
    const ua = navigator.userAgent;
    const isIOS       = /iPhone|iPad|iPod/i.test(ua);
    const isMacSafari = /Macintosh/i.test(ua) && /Safari/i.test(ua) && !/Chrome|CriOS|FxiOS|Edg/i.test(ua);
    if (isIOS || isMacSafari) {
        window.location.href = icalUrl(id);
    } else {
        window.open(googleCalUrl(a), '_blank', 'noopener');
    }
}

function googleCalUrl(a) {
    const [y, mo, d] = a.date.split('-');
    const [h, mi]    = a.time.split(':');
    const startDt    = `${y}${mo}${d}T${h}${mi}00`;
    const endH       = String(parseInt(h, 10) + 1).padStart(2, '0');
    const endDt      = `${y}${mo}${d}T${endH}${mi}00`;
    const text       = encodeURIComponent(a.booker_name + (a.employee_name ? ' — ' + a.employee_name : ''));
    const details    = encodeURIComponent(a.notes || '');
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${text}&dates=${startDt}/${endDt}&details=${details}`;
}

async function doConfirm(id) {
    const a = appointments.find(x => x.id === id);
    if (!a) return;

    // Capture employee selection NOW — the modal may be hidden before we submit
    const selectedEmpId = document.getElementById('modalEmployeeSelect')?.value || '';

    // Count how many confirmed bookings already exist at this exact date+time
    const confirmedCount = appointments.filter(x =>
        x.date === a.date && x.time === a.time && x.status === 'confirmed'
    ).length;

    // Other PENDING bookings at the same slot that would be cancelled
    const pendingOthers = appointments.filter(x =>
        x.date === a.date && x.time === a.time && x.id !== a.id && x.status === 'pending'
    );

    // This confirmation would fill the last slot AND there are others to cancel
    const isLastSlot = orgCapacity > 0 && confirmedCount + 1 >= orgCapacity;

    if (isLastSlot && pendingOthers.length > 0) {
        // Hide the appointment modal first so SweetAlert is clearly visible
        bootstrap.Modal.getInstance(document.getElementById('apptModal'))?.hide();

        const listItems = pendingOthers
            .map(o => `<li class="text-start">${o.booker_name} &mdash; ${o.date} ${o.time}</li>`)
            .join('');

        const result = await Swal.fire({
            title: T.capacityTitle,
            html: `<p class="text-muted small mb-2">${T.capacityText}</p>
                   <ul class="small mb-0 ps-3">${listItems}</ul>`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: T.capacityAccept,
            confirmButtonColor: '#10b981',
            cancelButtonText:  T.capacityDecline,
            cancelButtonColor: '#6b7280',
            reverseButtons: true,
            focusCancel: true,
        });

        if (!result.isConfirmed) {
            // User declined — re-open the appointment detail modal
            openModal(id);
            return;
        }

        // User accepted — submit with force flag so backend also cancels the others
        document.getElementById('confirmForce').value = '1';
    } else {
        document.getElementById('confirmForce').value = '0';
    }

    document.getElementById('confirmEmployeeId').value = selectedEmpId;

    const form = document.getElementById('confirmForm');
    form.action = confirmUrl(id);
    form.submit();
}

async function doCancel(id, name, confirmed) {
    // Read employee selection BEFORE hiding the modal (it vanishes when modal closes)
    const selectedEmpId = document.getElementById('modalEmployeeSelect')?.value || '';

    bootstrap.Modal.getInstance(document.getElementById('apptModal'))?.hide();
    const result = await Swal.fire({
        title: T.cancelTitle,
        html: `<p class="text-muted mb-0">${name}${confirmed ? ` <span class="badge bg-success ms-1">${T.confirmed}</span>` : ''}</p>`,
        input: 'textarea',
        inputLabel: T.cancelNoteLabel,
        inputPlaceholder: T.cancelNotePlaceholder,
        inputAttributes: { rows: 3, style: 'resize:none;font-size:.9rem' },
        showCancelButton: true,
        confirmButtonText: T.cancelYes,
        confirmButtonColor: '#dc3545',
        cancelButtonText: T.cancelKeep,
        reverseButtons: true,
        focusCancel: true,
    });
    if (result.isConfirmed) {
        const form = document.getElementById('cancelForm');
        form.action = cancelUrl(id);
        document.getElementById('cancelNote').value       = result.value || '';
        document.getElementById('cancelEmployeeId').value = selectedEmpId;
        form.submit();
    }
}

// Returns max selectable duration (mins) based on the next confirmed appt for same employee/day
function getMaxDurationMins(a) {
    const startMin = toMin(a.time);
    let nextMin = Infinity;
    appointments.forEach(other => {
        if (other.id === a.id || other.date !== a.date || other.status !== 'confirmed') return;
        if (a.employee_id && other.employee_id && a.employee_id !== other.employee_id) return;
        const oMin = toMin(other.time);
        if (oMin > startMin) nextMin = Math.min(nextMin, oMin);
    });
    const gap = nextMin === Infinity ? 240 : (nextMin - startMin);
    return Math.max(timeStep, Math.floor(gap / timeStep) * timeStep);
}

// Returns pending appointments that fall within [appt.time, appt.time + newDurMins)
function getOverlappingPending(a, newDurMins) {
    const startMin = toMin(a.time);
    const endMin   = startMin + newDurMins;
    return appointments.filter(other => {
        if (other.id === a.id || other.date !== a.date || other.status !== 'pending') return false;
        if (a.employee_id && other.employee_id && a.employee_id !== other.employee_id) return false;
        const oMin = toMin(other.time);
        return oMin >= startMin && oMin < endMin;
    });
}

async function onDurationChange(id, minutes) {
    const a = appointments.find(x => x.id === id);
    if (!a) return;
    minutes = +minutes;
    const overlapping = getOverlappingPending(a, minutes);
    if (overlapping.length > 0) {
        const items = overlapping.map(o => `<li>${o.booker_name} — ${o.time}</li>`).join('');
        const result = await Swal.fire({
            title: T.conflictTitle,
            html: `<p class="text-muted small mb-2">${T.conflictText}</p><ul class="text-start small mb-0">${items}</ul>`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: T.conflictConfirm,
            confirmButtonColor: '#dc3545',
            cancelButtonText: T.close,
            reverseButtons: true,
        });
        if (!result.isConfirmed) {
            // Revert the select to the current saved duration
            const sel = document.getElementById('durationSelect');
            if (sel) sel.value = a.duration_minutes || timeStep;
            return;
        }
        await saveDuration(id, minutes, overlapping.map(o => o.id));
    } else {
        await saveDuration(id, minutes, []);
    }
}

async function saveDuration(id, minutes, cancelIds = []) {
    const body = new URLSearchParams({ minutes });
    cancelIds.forEach(cid => body.append('cancel_ids[]', cid));
    const resp = await fetch(durationUrl(id), { method: 'POST', body });
    if (!resp.ok) return;
    const data = await resp.json();
    const a = appointments.find(x => x.id === id);
    if (a) a.duration_minutes = data.duration_minutes;
    if (data.cancelled?.length) {
        data.cancelled.forEach(cid => {
            const other = appointments.find(x => x.id === cid);
            if (other) other.status = 'cancelled';
        });
    }
    const saved = document.getElementById('durationSaved');
    if (saved) { saved.style.display = ''; setTimeout(() => saved.style.display = 'none', 1500); }
    renderCalendar();
}

document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        activeFilter = this.dataset.filter;
        renderCalendar();
    });
});

document.getElementById('prevWeek').addEventListener('click', () => {
    const today = startOfToday();
    windowStart = addDays(windowStart, -7);
    if (windowStart < today) windowStart = startOfWeek();
    renderCalendar();
});
document.getElementById('nextWeek').addEventListener('click', () => {
    windowStart = addDays(windowStart, 7);
    renderCalendar();
});
document.getElementById('todayBtn').addEventListener('click', () => {
    windowStart = startOfWeek();
    renderCalendar();
});
document.getElementById('collapseBtn').addEventListener('click', () => {
    collapseEmpty = !collapseEmpty;
    const btn   = document.getElementById('collapseBtn');
    const label = document.getElementById('collapseBtnLabel');
    label.textContent = collapseEmpty ? T.expand : T.collapse;
    btn.querySelector('i').className = collapseEmpty ? 'bi bi-arrows-expand me-1' : 'bi bi-arrows-collapse me-1';
    renderCalendar();
});

renderCalendar();

// ── Reports ────────────────────────────────────────────────────────────────
const customReportUrl  = {{ path('business_report_custom')|json_encode|raw }};
const monthlyReportUrl = {{ path('business_report_monthly')|json_encode|raw }};

function showError(elId, msg) {
    const el = document.getElementById(elId);
    el.textContent = msg;
    el.classList.remove('d-none');
}
function clearError(elId) {
    document.getElementById(elId).classList.add('d-none');
}

document.getElementById('reportCustomForm').addEventListener('submit', function(e) {
    e.preventDefault();
    clearError('cr_error');

    const from     = document.getElementById('cr_from').value;
    const to       = document.getElementById('cr_to').value;
    const status   = document.getElementById('cr_status').value;
    const employee = document.getElementById('cr_employee').value;

    if (!from) {
        document.getElementById('cr_from').classList.add('is-invalid');
        showError('cr_error', {{ 'report.error_no_from'|trans|json_encode|raw }});
        return;
    }
    document.getElementById('cr_from').classList.remove('is-invalid');

    if (!to) {
        document.getElementById('cr_to').classList.add('is-invalid');
        showError('cr_error', {{ 'report.error_no_to'|trans|json_encode|raw }});
        return;
    }
    document.getElementById('cr_to').classList.remove('is-invalid');

    if (from > to) {
        document.getElementById('cr_from').classList.add('is-invalid');
        document.getElementById('cr_to').classList.add('is-invalid');
        showError('cr_error', {{ 'report.error_date_order'|trans|json_encode|raw }});
        return;
    }
    document.getElementById('cr_from').classList.remove('is-invalid');
    document.getElementById('cr_to').classList.remove('is-invalid');

    const params = new URLSearchParams({ date_from: from, date_to: to });
    if (status)   params.set('status', status);
    if (employee) params.set('employee_id', employee);

    window.location.href = customReportUrl + '?' + params.toString();
});

document.getElementById('reportMonthlyForm').addEventListener('submit', function(e) {
    e.preventDefault();
    clearError('mr_error');

    const month = document.getElementById('mr_month').value;
    if (!month) {
        document.getElementById('mr_month').classList.add('is-invalid');
        showError('mr_error', {{ 'report.error_no_month'|trans|json_encode|raw }});
        return;
    }
    document.getElementById('mr_month').classList.remove('is-invalid');

    window.location.href = monthlyReportUrl + '?month=' + encodeURIComponent(month);
});

// Clear invalid state on input
['cr_from','cr_to'].forEach(id => {
    document.getElementById(id).addEventListener('input', () => {
        document.getElementById(id).classList.remove('is-invalid');
        clearError('cr_error');
    });
});
document.getElementById('mr_month').addEventListener('input', () => {
    document.getElementById('mr_month').classList.remove('is-invalid');
    clearError('mr_error');
});
</script>
