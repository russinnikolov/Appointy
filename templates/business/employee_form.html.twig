{% extends 'base.html.twig' %}
{% block title %}Add Employee — {{ organization.name }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-6">
        <a href="{{ path('business_employees') }}" class="btn btn-link text-muted ps-0 mb-3 small">
            <i class="bi bi-arrow-left me-1"></i>Back to employees
        </a>

        <div class="card p-4 p-md-5">
            <h5 class="fw-bold mb-1">Add Employee</h5>
            <p class="text-muted small mb-4">{{ organization.name }}</p>

            {% if error %}
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-circle me-1"></i>{{ error }}
                </div>
            {% endif %}

            <form method="post" novalidate>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control"
                           value="{{ app.request.request.get('name') }}" required placeholder="Jane Smith">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Role / Title</label>
                    <input type="text" name="role" class="form-control"
                           value="{{ app.request.request.get('role') }}" placeholder="Senior Barber, Doctor, Consultant…">
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Phone</label>
                        <input type="tel" name="phone" class="form-control"
                               value="{{ app.request.request.get('phone') }}" placeholder="+1 555 000 0000">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Email</label>
                        <input type="email" name="email" class="form-control"
                               value="{{ app.request.request.get('email') }}" placeholder="jane@example.com">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small">Bio <span class="text-muted">(optional)</span></label>
                    <textarea name="bio" class="form-control" rows="3"
                              placeholder="Short description shown to clients…">{{ app.request.request.get('bio') }}</textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-person-plus me-1"></i>Add Employee
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
