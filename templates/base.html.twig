<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Appointy{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --primary: #6366f1; --primary-dark: #4f46e5; }
        body { background: #f8f9ff; }
        .navbar-brand { font-weight: 700; letter-spacing: -0.5px; color: var(--primary) !important; }
        .btn-primary { background: var(--primary); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
        .btn-outline-primary { color: var(--primary); border-color: var(--primary); }
        .btn-outline-primary:hover { background: var(--primary); border-color: var(--primary); }
        .nav-link.active { background: white !important; color: var(--primary) !important; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .card { border: none; box-shadow: 0 2px 12px rgba(0,0,0,.06); border-radius: 1rem; }
        .status-badge { padding: .3em .7em; border-radius: 999px; font-size: .78rem; font-weight: 600; }
        .badge-pending   { background: #fef3c7; color: #92400e; }
        .badge-confirmed { background: #d1fae5; color: #065f46; }
        .badge-cancelled { background: #fee2e2; color: #991b1b; }
        footer { border-top: 1px solid #e5e7eb; }
    </style>
    {% block head %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg bg-white shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="{{ path('home') }}">
            <i class="bi bi-calendar-check me-1"></i>Appointy
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                {% if app.user %}
                    {% if is_granted('ROLE_BUSINESS') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('business_dashboard') }}">
                                <i class="bi bi-grid me-1"></i>Dashboard
                            </a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('client_dashboard') }}">
                                <i class="bi bi-grid me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('client_organizations') }}">
                                <i class="bi bi-building me-1"></i>Find Organizations
                            </a>
                        </li>
                    {% endif %}
                    <li class="nav-item">
                        <span class="text-muted small me-2">
                            <i class="bi bi-person-circle me-1"></i>{{ app.user.name }}
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('logout') }}">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm" href="{{ path('login') }}">
                            <i class="bi bi-person me-1"></i>Login
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="btn btn-primary btn-sm dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-plus me-1"></i>Register
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('register', {type: 'client'}) }}">
                                    <i class="bi bi-person me-2"></i>As Client
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('register', {type: 'business'}) }}">
                                    <i class="bi bi-building me-2"></i>As Business
                                </a>
                            </li>
                        </ul>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main class="py-4">
    <div class="container">
        {% for type, messages in app.flashes %}
            {% for msg in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                    {{ msg }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</main>

<footer class="py-3 mt-4 text-center text-muted small">
    &copy; {{ "now"|date("Y") }} Appointy &mdash; Book smarter.
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
