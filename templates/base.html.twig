<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Grafira{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root { --primary: #6366f1; --primary-dark: #4f46e5; }
        body { background: #f8f9ff; }
        .navbar-brand { font-weight: 700; letter-spacing: -0.5px; color: var(--primary) !important; }
        .btn-primary { background: var(--primary); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }
        .btn-outline-primary { color: var(--primary); border-color: var(--primary); }
        .btn-outline-primary:hover { background: var(--primary); border-color: var(--primary); }
        .nav-link.active { background: white !important; color: var(--primary) !important; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .card { border: none; box-shadow: 0 2px 12px rgba(0,0,0,.06); border-radius: 1rem; }
        .status-badge { padding: .3em .7em; border-radius: 999px; font-size: .78rem; font-weight: 600; }
        .badge-pending   { background: #fef3c7; color: #92400e; }
        .badge-confirmed { background: #d1fae5; color: #065f46; }
        .badge-cancelled { background: #fee2e2; color: #991b1b; }
        footer { border-top: 1px solid #e5e7eb; }
        .link-hover:hover { text-decoration: underline !important; }
        .lang-btn { font-size: .75rem; padding: 2px 8px; border-radius: 6px; }
        .lang-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }
        .dropdown-menu { padding: .5rem 0; }
        .dropdown-item { font-size: .875rem; padding: .45rem 1rem; border-radius: .5rem; margin: 0 .25rem; width: calc(100% - .5rem); }
        .dropdown-item:hover { background: #f3f4ff; }
        .dropdown-item.text-danger:hover { background: #fff5f5; }
        .dropdown-header { font-size: .65rem; color: #9ca3af; padding: .5rem 1rem .2rem; }
        .dropdown-divider { margin: .3rem 0; }
    </style>
    {% block head %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg bg-white shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="{{ path('home') }}">
            <i class="bi bi-calendar-check me-1"></i>Grafira
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                {% if app.user %}

                    {# ── Client top-level links ── #}
                    {% if not is_granted('ROLE_BUSINESS') and not is_granted('ROLE_EMPLOYEE') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('client_organizations') }}">
                                <i class="bi bi-building me-1"></i>{{ 'nav.browse'|trans }}
                            </a>
                        </li>
                    {% endif %}

                    {# ── Employee top-level links ── #}
                    {% if is_granted('ROLE_EMPLOYEE') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('employee_dashboard') }}">
                                <i class="bi bi-calendar3 me-1"></i>{{ 'nav.my_schedule'|trans }}
                            </a>
                        </li>
                    {% endif %}

                    {# ── Profile dropdown ── #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-1"
                           href="#" id="profileDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            {% if app.user.avatarFilename %}
                                <img src="/uploads/avatars/{{ app.user.avatarFilename }}"
                                     class="rounded-circle" style="width:28px;height:28px;object-fit:cover;" alt="">
                            {% else %}
                                <span class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                                      style="width:28px;height:28px">
                                    <i class="bi bi-person" style="font-size:.85rem"></i>
                                </span>
                            {% endif %}
                            <span class="small fw-medium">{{ app.user.name }}</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-1"
                            style="min-width:220px;border-radius:.75rem" aria-labelledby="profileDropdown">

                            {% if is_granted('ROLE_BUSINESS') %}
                                {# ── Manage section ── #}
                                <li>
                                    <span class="dropdown-header text-uppercase" style="font-size:.65rem;letter-spacing:.07em">
                                        {{ 'nav.manage'|trans }}
                                    </span>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('business_employees') }}">
                                        <i class="bi bi-people me-2 text-muted"></i>{{ 'nav.employees'|trans }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('business_services') }}">
                                        <i class="bi bi-bag-heart me-2 text-muted"></i>{{ 'nav.services'|trans }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('business_working_hours') }}">
                                        <i class="bi bi-clock me-2 text-muted"></i>{{ 'nav.working_hours'|trans }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('business_blocked_times') }}">
                                        <i class="bi bi-calendar-x me-2 text-muted"></i>{{ 'nav.blocked_times'|trans }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('business_trusted_clients') }}">
                                        <i class="bi bi-patch-check me-2 text-muted"></i>{{ 'nav.trusted_clients'|trans }}
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>

                                {# ── Account section ── #}
                                <li>
                                    <span class="dropdown-header text-uppercase" style="font-size:.65rem;letter-spacing:.07em">
                                        {{ 'nav.account'|trans }}
                                    </span>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('business_profile') }}">
                                        <i class="bi bi-person-gear me-2 text-muted"></i>{{ 'nav.profile'|trans }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('business_settings_info') }}">
                                        <i class="bi bi-sliders me-2 text-muted"></i>{{ 'nav.settings'|trans }}
                                    </a>
                                </li>

                            {% elseif is_granted('ROLE_EMPLOYEE') %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('employee_profile') }}">
                                        <i class="bi bi-person-gear me-2 text-muted"></i>{{ 'nav.profile'|trans }}
                                    </a>
                                </li>

                            {% else %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('client_profile') }}">
                                        <i class="bi bi-person-gear me-2 text-muted"></i>{{ 'nav.profile'|trans }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="{{ path('client_favourites') }}">
                                        <i class="bi bi-star me-2 text-muted"></i>{{ 'nav.favourites'|trans }}
                                    </a>
                                </li>
                            {% endif %}

                            {# ── Language ── #}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <span class="dropdown-header text-uppercase" style="font-size:.65rem;letter-spacing:.07em">
                                    {{ 'nav.language'|trans }}
                                </span>
                            </li>
                            <li>
                                <div class="px-3 pb-1 d-flex gap-2">
                                    <a href="{{ path('set_locale', {locale: 'bg'}) }}"
                                       class="btn btn-sm flex-fill lang-btn {{ app.request.locale == 'bg' ? 'active' : 'btn-outline-secondary' }}">БГ</a>
                                    <a href="{{ path('set_locale', {locale: 'en'}) }}"
                                       class="btn btn-sm flex-fill lang-btn {{ app.request.locale == 'en' ? 'active' : 'btn-outline-secondary' }}">EN</a>
                                </div>
                            </li>

                            {# ── Logout ── #}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('logout') }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>{{ 'nav.logout'|trans }}
                                </a>
                            </li>
                        </ul>
                    </li>

                {% else %}
                    {# ── Guest links ── #}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('public_organizations') }}">
                            <i class="bi bi-building me-1"></i>{{ 'nav.browse'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('contact') }}">
                            <i class="bi bi-envelope me-1"></i>{{ 'nav.contact'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm" href="{{ path('login') }}">
                            <i class="bi bi-person me-1"></i>{{ 'nav.login'|trans }}
                        </a>
                    </li>

                    {# Language switcher for guests #}
                    <li class="nav-item d-flex gap-1 ms-1">
                        <a href="{{ path('set_locale', {locale: 'bg'}) }}"
                           class="btn btn-outline-secondary btn-sm lang-btn {{ app.request.locale == 'bg' ? 'active' : '' }}">БГ</a>
                        <a href="{{ path('set_locale', {locale: 'en'}) }}"
                           class="btn btn-outline-secondary btn-sm lang-btn {{ app.request.locale == 'en' ? 'active' : '' }}">EN</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main class="py-4">
    <div class="container">
        {% for type, messages in app.flashes %}
            {% for msg in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'warning' ? 'warning' : 'danger') }} alert-dismissible fade show" role="alert">
                    {{ msg }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</main>

<footer class="py-3 mt-4 text-center text-muted small">
    &copy; {{ "now"|date("Y") }} Grafira &mdash; {{ 'footer.tagline'|trans }}
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{% block scripts %}{% endblock %}
{% if app.user %}
<script>
(function () {
    const INACTIVE_MS = 15 * 60 * 1000;   // 15 minutes until warning
    const COUNTDOWN_S = 60;                // seconds shown in the alert before auto-logout
    const LOGOUT_URL  = {{ path('logout')|json_encode|raw }};

    const T = {
        title:    {{ 'idle.title'|trans|json_encode|raw }},
        html:     {{ 'idle.html'|trans|json_encode|raw }},
        confirm:  {{ 'idle.keep'|trans|json_encode|raw }},
        cancel:   {{ 'idle.logout'|trans|json_encode|raw }},
    };

    let idleTimer   = null;
    let alertOpen   = false;

    function resetTimer() {
        if (alertOpen) return;
        clearTimeout(idleTimer);
        idleTimer = setTimeout(showWarning, INACTIVE_MS);
    }

    function showWarning() {
        alertOpen = true;
        let sLeft = COUNTDOWN_S;
        let ticker = null;

        Swal.fire({
            title:              T.title,
            html:               T.html.replace('%s', `<b id="idleSec">${sLeft}</b>`),
            icon:               'warning',
            showCancelButton:   true,
            confirmButtonText:  T.confirm,
            cancelButtonText:   T.cancel,
            confirmButtonColor: '#6366f1',
            cancelButtonColor:  '#ef4444',
            allowOutsideClick:  false,
            allowEscapeKey:     false,
            reverseButtons:     true,
            timerProgressBar:   true,
            timer:              COUNTDOWN_S * 1000,
            didOpen: () => {
                ticker = setInterval(() => {
                    sLeft--;
                    const el = document.getElementById('idleSec');
                    if (el) el.textContent = sLeft;
                }, 1000);
            },
            willClose: () => clearInterval(ticker),
        }).then(result => {
            alertOpen = false;
            if (result.isConfirmed) {
                resetTimer();          // user chose "Keep me logged in"
            } else {
                window.location.href = LOGOUT_URL;   // timer expired or "Logout"
            }
        });
    }

    ['mousemove', 'keydown', 'mousedown', 'scroll', 'touchstart'].forEach(ev =>
        document.addEventListener(ev, resetTimer, { passive: true })
    );

    resetTimer();
})();
</script>
{% endif %}
</body>
</html>
