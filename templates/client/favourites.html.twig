{% extends 'base.html.twig' %}
{% block title %}{{ 'fav.title'|trans }} — Grafira{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-star-fill me-2" style="color:#f59e0b"></i>{{ 'fav.title'|trans }}</h4>
        <p class="text-muted small mb-0">{{ 'fav.subtitle'|trans }}</p>
    </div>
    <a href="{{ path('client_organizations') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-building me-1"></i>{{ 'nav.find_organizations'|trans }}
    </a>
</div>

{% if organizations is empty %}
    <div class="card p-5 text-center">
        <div style="font-size:3rem; color:#d1d5db"><i class="bi bi-star"></i></div>
        <h5 class="fw-semibold mt-3 mb-1">{{ 'fav.empty_title'|trans }}</h5>
        <p class="text-muted small mb-3">{{ 'fav.empty_text'|trans }}</p>
        <a href="{{ path('client_organizations') }}" class="btn btn-primary btn-sm mx-auto px-4">
            <i class="bi bi-search me-1"></i>{{ 'fav.browse_btn'|trans }}
        </a>
    </div>
{% else %}
    <div class="row g-3">
        {% for org in organizations %}
            <div class="col-md-6 col-lg-4" id="fav-org-{{ org.id }}">
                <div class="card h-100 p-3">
                    <div class="d-flex align-items-start justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            {% if org.logoFilename %}
                                <img src="/uploads/logos/{{ org.logoFilename }}" alt="{{ org.name }}"
                                     class="rounded-circle flex-shrink-0"
                                     style="width:42px;height:42px;object-fit:cover;border:1px solid #e5e7eb">
                            {% else %}
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:42px;height:42px;background:#ede9fe;color:#6366f1;font-size:1.2rem">
                                    <i class="bi bi-building"></i>
                                </div>
                            {% endif %}
                        </div>
                        <button class="btn btn-link p-0 fav-btn"
                                data-org-id="{{ org.id }}"
                                data-toggle-url="{{ path('client_favourite_toggle', {id: org.id}) }}"
                                title="{{ 'fav.remove'|trans }}">
                            <i class="bi bi-star-fill" style="font-size:1.2rem;color:#f59e0b"></i>
                        </button>
                    </div>

                    <h6 class="fw-bold mb-1">{{ org.name }}</h6>
                    {% if org.category %}
                        <span class="badge bg-light text-secondary border small mb-1">{{ ('category.' ~ org.category)|trans }}</span>
                    {% endif %}

                    {% if org.fullAddress or org.address %}
                        {% set addrText = org.fullAddress ?: org.address %}
                        {% set mapsQuery = org.latitude and org.longitude
                            ? org.latitude ~ ',' ~ org.longitude
                            : addrText %}
                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt me-1"></i>
                            <a href="https://www.google.com/maps/search/?api=1&query={{ mapsQuery|url_encode }}"
                               target="_blank" rel="noopener" class="text-muted text-decoration-none link-hover">{{ addrText }}</a>
                        </p>
                    {% endif %}
                    {% if org.phone %}
                        <p class="text-muted small mb-1">
                            <i class="bi bi-telephone me-1"></i>
                            <a href="tel:{{ org.phone }}" class="text-muted text-decoration-none link-hover">{{ org.phone }}</a>
                        </p>
                    {% endif %}
                    {% if org.email %}
                        <p class="text-muted small mb-2">
                            <i class="bi bi-envelope me-1"></i>
                            <a href="mailto:{{ org.email }}" class="text-muted text-decoration-none link-hover">{{ org.email }}</a>
                        </p>
                    {% endif %}

                    {% if org.description %}
                        <p class="text-muted small mb-2 flex-grow-1"
                           style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                            {{ org.description }}
                        </p>
                    {% endif %}

                    <div class="d-flex gap-2 mt-auto pt-2">
                        <a href="{{ path('public_organization', {id: org.id}) }}"
                           class="btn btn-outline-secondary btn-sm flex-grow-1">
                            <i class="bi bi-eye me-1"></i>{{ 'org.view_profile'|trans }}
                        </a>
                        <a href="{{ path('client_book', {id: org.id}) }}"
                           class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-calendar-plus me-1"></i>{{ 'org.book'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
document.querySelectorAll('.fav-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const orgId = btn.dataset.orgId;
        const url   = btn.dataset.toggleUrl;
        try {
            const res  = await fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            if (!data.favourited) {
                // Animate card out then remove
                const card = document.getElementById('fav-org-' + orgId);
                card.style.transition = 'opacity .3s';
                card.style.opacity = '0';
                setTimeout(() => {
                    card.remove();
                    if (!document.querySelector('[id^="fav-org-"]')) location.reload();
                }, 300);
            }
        } catch(e) { console.error(e); }
    });
});
</script>
{% endblock %}
