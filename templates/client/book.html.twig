{% extends 'base.html.twig' %}
{% set activeEmployees = employees|filter(e => e.isActive) %}
{% set singleEmployee = activeEmployees|length == 1 ? activeEmployees|first : null %}
{% block title %}{{ 'org.book'|trans }} — {{ organization.name }}{% endblock %}

{% block head %}
<style>
/* ── Date carousel ── */
.picker-card { border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
.picker-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid #f3f4f6; }
.picker-header .month-label { font-weight: 700; font-size: .95rem; color: #111; }
.nav-arrow { width: 32px; height: 32px; border-radius: 8px; border: 1px solid #e5e7eb; background: #f9fafb; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: .15s; color: #6b7280; }
.nav-arrow:hover { background: #ede9fe; border-color: #6366f1; color: #6366f1; }
.nav-arrow.disabled { opacity: .35; pointer-events: none; }

.date-strip { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0; }
.date-btn { display: flex; flex-direction: column; align-items: center; padding: 10px 4px 12px; cursor: pointer; transition: .15s; border-right: 1px solid #f3f4f6; user-select: none; }
.date-btn:last-child { border-right: none; }
.date-btn .d-name { font-size: .65rem; font-weight: 700; text-transform: uppercase; color: #9ca3af; margin-bottom: 4px; }
.date-btn .d-num { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .95rem; font-weight: 700; color: #111; transition: .15s; }
.date-btn:hover:not(.disabled) .d-num { background: #ede9fe; color: #6366f1; }
.date-btn.selected .d-num { background: #6366f1; color: #fff; }
.date-btn.selected .d-name { color: #6366f1; }
.date-btn.disabled { cursor: default; opacity: .35; }
.date-btn.today .d-name::after { content: '·'; display: block; text-align: center; color: #6366f1; font-size: .8rem; line-height: .5; }

/* ── Time grid ── */
.time-section { margin-top: 20px; }
.time-section-label { font-size: .78rem; font-weight: 700; text-transform: uppercase; color: #6b7280; margin-bottom: 10px; letter-spacing: .04em; }
.time-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
@media (max-width: 400px) { .time-grid { grid-template-columns: repeat(3, 1fr); } }
.time-btn { padding: 11px 6px; border-radius: 10px; border: 1.5px solid #e5e7eb; background: #fff; font-size: .85rem; font-weight: 600; color: #374151; cursor: pointer; transition: .15s; text-align: center; }
.time-btn:hover { border-color: #6366f1; color: #6366f1; background: #f5f3ff; }
.time-btn.selected { background: #6366f1; border-color: #6366f1; color: #fff; }
.time-empty { text-align: center; color: #9ca3af; font-size: .85rem; padding: 24px 0; }
</style>
{% endblock %}

{% block body %}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-9 col-lg-7">
        <a href="{{ path('client_organizations') }}" class="btn btn-link text-muted ps-0 mb-3 small">
            <i class="bi bi-arrow-left me-1"></i>{{ 'book.back_to_orgs'|trans }}
        </a>

        <div class="card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                {% if organization.logoFilename %}
                    <img src="/uploads/logos/{{ organization.logoFilename }}" alt="{{ organization.name }}"
                         class="rounded-circle flex-shrink-0"
                         style="width:52px;height:52px;object-fit:cover;border:1px solid #e5e7eb">
                {% else %}
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:52px;height:52px;background:#ede9fe;color:#6366f1;font-size:1.5rem">
                        <i class="bi bi-building"></i>
                    </div>
                {% endif %}
                <div>
                    <h5 class="fw-bold mb-0">{{ organization.name }}</h5>
                    <p class="text-muted small mb-0">
                        {% if organization.category %}{{ ('category.' ~ organization.category)|trans }}{% endif %}
                        {% if organization.fullAddress %} · {{ organization.fullAddress }}{% endif %}
                    </p>
                </div>
            </div>

            {% if error %}
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-circle me-1"></i>{{ error }}
                </div>
            {% endif %}

            <form method="post" novalidate id="bookForm">
                {% if activeEmployees is not empty and singleEmployee is null %}
                <div class="mb-3">
                    <label class="form-label fw-semibold small">{{ 'book.employee'|trans }} <span class="text-muted">({{ 'book.employee_optional'|trans }})</span></label>
                    <select name="employee_id" class="form-select" id="employeeSelect" onchange="onEmployeeChange()">
                        <option value="">{{ 'book.any_employee'|trans }}</option>
                        {% for emp in activeEmployees %}
                            <option value="{{ emp.id }}"
                                data-lunch-start="{{ emp.lunchBreakStart ? emp.lunchBreakStart|date('H:i') : '' }}"
                                data-lunch-end="{{ emp.lunchBreakEnd ? emp.lunchBreakEnd|date('H:i') : '' }}"
                                {{ app.request.request.get('employee_id') == emp.id ? 'selected' : '' }}>
                                {{ emp.name }}{% if emp.role %} — {{ emp.role }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                {% elseif singleEmployee %}
                    <input type="hidden" name="employee_id" value="{{ singleEmployee.id }}">
                {% endif %}

                <div id="empPortfolio" class="mb-4" style="display:none">
                    <div class="d-flex gap-2 flex-wrap" id="empPortfolioStrip"></div>
                </div>

                <input type="hidden" name="date" id="selectedDate" value="" required>
                <input type="hidden" name="time" id="selectedTime" value="" required>

                <div class="mb-2">
                    <label class="form-label fw-semibold small mb-2">{{ 'book.date'|trans }}</label>
                    <div class="picker-card">
                        <div class="picker-header">
                            <button type="button" class="nav-arrow" id="prevWeek"><i class="bi bi-chevron-left"></i></button>
                            <span class="month-label" id="monthLabel"></span>
                            <button type="button" class="nav-arrow" id="nextWeek"><i class="bi bi-chevron-right"></i></button>
                        </div>
                        <div class="date-strip" id="dateStrip"></div>
                    </div>
                </div>

                <div class="time-section" id="timeSection" style="display:none">
                    <div class="time-section-label"><i class="bi bi-clock me-1"></i>{{ 'book.available_times'|trans }}</div>
                    <div class="time-grid" id="timeGrid"></div>
                    <div class="time-empty" id="timeEmpty" style="display:none">
                        <i class="bi bi-calendar-x me-1"></i>{{ 'book.no_slots'|trans }}
                    </div>
                </div>

                <div class="mb-4 mt-4">
                    <label class="form-label fw-semibold small">{{ 'common.notes'|trans }} <span class="text-muted">({{ 'common.optional'|trans }})</span></label>
                    <textarea name="notes" class="form-control" rows="2"
                              placeholder="{{ 'book.notes_placeholder'|trans }}">{{ app.request.request.get('notes') }}</textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" id="submitBtn" disabled>
                    <i class="bi bi-calendar-check me-1"></i>{{ 'book.submit'|trans }}
                </button>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="portfolioModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-0">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-2">
                <img id="portfolioModalImg" src="" alt="" style="max-height:70vh;max-width:100%;border-radius:8px;object-fit:contain">
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0 pb-3 gap-2" id="portfolioModalThumbs"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{% set dayAbbr = [
    'cal.day.0'|trans, 'cal.day.1'|trans, 'cal.day.2'|trans,
    'cal.day.3'|trans, 'cal.day.4'|trans, 'cal.day.5'|trans, 'cal.day.6'|trans
] %}
{% set monthNames = [
    'cal.month.0'|trans, 'cal.month.1'|trans, 'cal.month.2'|trans,
    'cal.month.3'|trans, 'cal.month.4'|trans, 'cal.month.5'|trans,
    'cal.month.6'|trans, 'cal.month.7'|trans, 'cal.month.8'|trans,
    'cal.month.9'|trans, 'cal.month.10'|trans, 'cal.month.11'|trans
] %}
<script>
const orgHours   = {{ organization.workingHours|json_encode|raw }};
const nonstop    = {{ organization.nonstop ? 'true' : 'false' }};
const timeStep   = {{ organization.timeStep }};
const dayNames   = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];
const phpDayMap  = { sunday:0, monday:1, tuesday:2, wednesday:3, thursday:4, friday:5, saturday:6 };
const singleEmpId = {{ singleEmployee ? singleEmployee.id : 'null' }};
const singleLunch = {
    start: {{ singleEmployee and singleEmployee.lunchBreakStart ? ('"'~singleEmployee.lunchBreakStart|date('H:i')~'"')|raw : 'null' }},
    end:   {{ singleEmployee and singleEmployee.lunchBreakEnd   ? ('"'~singleEmployee.lunchBreakEnd|date('H:i')~'"')|raw   : 'null' }}
};
const empHoursMap = {
    {% for emp in activeEmployees %}
        {{ emp.id }}: {{ emp.workingHours ? emp.workingHours|json_encode|raw : 'null' }}{% if not loop.last %},{% endif %}
    {% endfor %}
};
const empPortfolioMap = {
    {% for emp in activeEmployees %}
        {{ emp.id }}: {{ emp.portfolioPhotos ? emp.portfolioPhotos|json_encode|raw : '[]' }}{% if not loop.last %},{% endif %}
    {% endfor %}
};
const singleEmpPortfolio = {{ singleEmployee and singleEmployee.portfolioPhotos ? singleEmployee.portfolioPhotos|json_encode|raw : '[]' }};

function getEffectiveHours(empId) {
    if (empId && empHoursMap[empId]) return empHoursMap[empId];
    return orgHours;
}
function getDisabledDays(hours) {
    if (nonstop) return [];
    return Object.entries(hours)
        .filter(([,cfg]) => !cfg.enabled)
        .map(([day]) => phpDayMap[day]);
}
let disabledDays = getDisabledDays(getEffectiveHours(singleEmpId));
let workingHours = getEffectiveHours(singleEmpId);
const DAY_ABBR    = {{ dayAbbr|json_encode|raw }};
const MONTH_NAMES = {{ monthNames|json_encode|raw }};
const MSG_NO_SLOTS     = {{ 'book.no_slots'|trans|json_encode|raw }};
const MSG_VALIDATION   = {{ 'book.validation_msg'|trans|json_encode|raw }};
const toMin = t => { const [h,m] = t.split(':').map(Number); return h*60+m; };
const toStr = m => String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0');

let windowStart    = startOfToday();
let selectedDate   = null;
let selectedTime   = null;
let busySlots      = [];
let blockedRanges  = [];

function startOfToday() {
    const d = new Date(); d.setHours(0,0,0,0); return d;
}
function addDays(d, n) {
    const r = new Date(d); r.setDate(r.getDate() + n); return r;
}
function isoDate(d) {
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}

function renderDateStrip() {
    const today   = startOfToday();
    const strip   = document.getElementById('dateStrip');
    const label   = document.getElementById('monthLabel');
    strip.innerHTML = '';

    const months = new Set();
    for (let i = 0; i < 7; i++) {
        const d = addDays(windowStart, i);
        months.add(MONTH_NAMES[d.getMonth()] + ' ' + d.getFullYear());
    }
    label.textContent = [...months].join(' / ');

    document.getElementById('prevWeek').classList.toggle('disabled',
        windowStart <= today);

    for (let i = 0; i < 7; i++) {
        const d        = addDays(windowStart, i);
        const isPast   = d < today;
        const isClosed = disabledDays.includes(d.getDay());
        const isToday  = isoDate(d) === isoDate(today);
        const isSel    = selectedDate && isoDate(d) === isoDate(selectedDate);

        const btn = document.createElement('div');
        btn.className = 'date-btn' +
            (isPast || isClosed ? ' disabled' : '') +
            (isToday ? ' today' : '') +
            (isSel ? ' selected' : '');

        btn.innerHTML = `<span class="d-name">${DAY_ABBR[d.getDay()]}</span><span class="d-num">${d.getDate()}</span>`;

        if (!isPast && !isClosed) {
            btn.addEventListener('click', () => selectDate(d));
        }
        strip.appendChild(btn);
    }
}

function selectDate(d) {
    selectedDate = d;
    selectedTime = null;
    document.getElementById('selectedDate').value = isoDate(d);
    document.getElementById('selectedTime').value = '';
    document.getElementById('submitBtn').disabled = true;
    renderDateStrip();
    loadSlots();
}

async function loadSlots() {
    busySlots     = [];
    blockedRanges = [];
    const empId   = getSelectedEmployeeId();

    if (empId) {
        try {
            const res  = await fetch(`/api/busy-slots?employee_id=${empId}&date=${isoDate(selectedDate)}`);
            const data = await res.json();
            busySlots     = data.booked  || [];
            blockedRanges = data.blocked || [];
        } catch {}
    }
    renderTimeGrid();
}

function renderTimeGrid() {
    const section = document.getElementById('timeSection');
    const grid    = document.getElementById('timeGrid');
    const empty   = document.getElementById('timeEmpty');

    section.style.display = '';
    grid.innerHTML = '';
    empty.style.display = 'none';

    const day = dayNames[selectedDate.getDay()];
    const cfg = workingHours[day];

    if (!nonstop && (!cfg || !cfg.enabled)) {
        empty.style.display = '';
        return;
    }

    const openMin  = nonstop ? 0      : toMin(cfg.open);
    const closeMin = nonstop ? 24*60  : toMin(cfg.close);

    const lunch = getLunch();
    const lsMin = lunch.start ? toMin(lunch.start) : null;
    const leMin = lunch.end   ? toMin(lunch.end)   : null;

    let count = 0;
    for (let t = openMin; t < closeMin; t += timeStep) {
        if (lsMin !== null && t >= lsMin && t < leMin) continue;
        const ts = toStr(t);
        if (isUnavailable(ts)) continue;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'time-btn' + (selectedTime === ts ? ' selected' : '');
        btn.textContent = ts;
        btn.addEventListener('click', () => selectTime(ts));
        grid.appendChild(btn);
        count++;
    }

    if (count === 0) empty.style.display = '';
}

function isUnavailable(ts) {
    if (busySlots.includes(ts)) return true;
    const tMin = toMin(ts);
    return blockedRanges.some(b => tMin >= toMin(b.start) && tMin < toMin(b.end));
}

function selectTime(ts) {
    selectedTime = ts;
    document.getElementById('selectedTime').value = ts;
    document.getElementById('submitBtn').disabled = false;
    document.querySelectorAll('.time-btn').forEach(b => b.classList.toggle('selected', b.textContent === ts));
}

function getSelectedEmployeeId() {
    if (singleEmpId) return singleEmpId;
    const sel = document.getElementById('employeeSelect');
    return sel ? (sel.value || null) : null;
}

function getLunch() {
    if (singleEmpId) return singleLunch;
    const sel = document.getElementById('employeeSelect');
    if (!sel || !sel.value) return { start: null, end: null };
    const opt = sel.options[sel.selectedIndex];
    return { start: opt.dataset.lunchStart || null, end: opt.dataset.lunchEnd || null };
}

function renderEmpPortfolio(photos) {
    const wrap  = document.getElementById('empPortfolio');
    const strip = document.getElementById('empPortfolioStrip');
    if (!wrap) return;
    if (!photos || photos.length === 0) { wrap.style.display = 'none'; return; }
    strip.innerHTML = photos.map((p, i) =>
        `<img src="/uploads/portfolio/${p}" alt=""
              style="width:64px;height:64px;object-fit:cover;border-radius:8px;cursor:pointer;border:1px solid #e5e7eb"
              onclick="openPortfolioGallery(${i}, ${JSON.stringify(photos)})">`
    ).join('');
    wrap.style.display = '';
}

let _gPhotos = [], _gIdx = 0;
function openPortfolioGallery(idx, photos) {
    _gPhotos = photos; _gIdx = idx;
    renderPortfolioLightbox();
    bootstrap.Modal.getOrCreateInstance(document.getElementById('portfolioModal')).show();
}
function renderPortfolioLightbox() {
    document.getElementById('portfolioModalImg').src = '/uploads/portfolio/' + _gPhotos[_gIdx];
    document.getElementById('portfolioModalThumbs').innerHTML = _gPhotos.map((p, i) =>
        `<img src="/uploads/portfolio/${p}" onclick="setPortfolioIdx(${i})"
              style="width:44px;height:44px;object-fit:cover;border-radius:6px;cursor:pointer;opacity:${i===_gIdx?1:.5};border:2px solid ${i===_gIdx?'#6366f1':'transparent'}">`
    ).join('');
}
function setPortfolioIdx(i) { _gIdx = i; renderPortfolioLightbox(); }
document.addEventListener('keydown', e => {
    const modal = document.getElementById('portfolioModal');
    if (!modal || !modal.classList.contains('show')) return;
    if (e.key === 'ArrowRight') setPortfolioIdx((_gIdx + 1) % _gPhotos.length);
    if (e.key === 'ArrowLeft')  setPortfolioIdx((_gIdx - 1 + _gPhotos.length) % _gPhotos.length);
});

async function onEmployeeChange() {
    const empId = getSelectedEmployeeId();
    workingHours = getEffectiveHours(empId);
    disabledDays = getDisabledDays(workingHours);
    if (selectedDate && disabledDays.includes(selectedDate.getDay())) {
        selectedDate = null;
        selectedTime = null;
        document.getElementById('selectedDate').value = '';
        document.getElementById('selectedTime').value = '';
        document.getElementById('submitBtn').disabled = true;
    }
    renderEmpPortfolio(empId ? (empPortfolioMap[empId] || []) : []);
    renderDateStrip();
    if (selectedDate) await loadSlots();
}

document.getElementById('prevWeek').addEventListener('click', () => {
    const today = startOfToday();
    windowStart = addDays(windowStart, -7);
    if (windowStart < today) windowStart = today;
    renderDateStrip();
});
document.getElementById('nextWeek').addEventListener('click', () => {
    windowStart = addDays(windowStart, 7);
    renderDateStrip();
});

document.getElementById('bookForm').addEventListener('submit', e => {
    if (!document.getElementById('selectedDate').value || !document.getElementById('selectedTime').value) {
        e.preventDefault();
        alert(MSG_VALIDATION);
    }
});

renderEmpPortfolio(singleEmpId ? singleEmpPortfolio : []);
renderDateStrip();
</script>
{% endblock %}
