{% extends 'base.html.twig' %}
{% block title %}{{ 'client.title'|trans }} — Grafira{% endblock %}

{% block head %}
<style>
/* ── Calendar ── */
.cal-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.cal-table { border-collapse: collapse; min-width: 700px; table-layout: fixed; }
.cal-table th, .cal-table td { border: 1px solid #f3f4f6; }

.cal-time-th { width: 58px; background: #fff; }
.cal-day-th  { text-align: center; padding: 10px 4px 8px; background: #f9fafb; min-width: 110px; }
.cal-day-th .d-name { font-size: .63rem; font-weight: 700; text-transform: uppercase; color: #9ca3af; letter-spacing: .05em; }
.cal-day-th .d-num  { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .9rem; font-weight: 700; color: #374151; margin: 3px auto 0; }
.cal-day-th.today   { background: #f5f3ff; border-bottom: 2px solid #6366f1; }
.cal-day-th.today .d-num { background: #6366f1; color: #fff; }

.cal-time-td { font-size: .7rem; color: #9ca3af; text-align: right; padding: 0 8px; white-space: nowrap; vertical-align: top; padding-top: 8px; width: 58px; background: #fff; }
.cal-day-td  { vertical-align: top; padding: 3px; min-height: 52px; height: 52px; }

.cal-appt { border-radius: 6px; padding: 4px 7px; font-size: .75rem; font-weight: 600; cursor: pointer; margin-bottom: 2px; line-height: 1.3; transition: opacity .1s, transform .1s; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cal-appt:hover { opacity: .82; transform: translateY(-1px); }
.cal-appt.pending   { background: #fef3c7; color: #92400e; border-left: 3px solid #f59e0b; }
.cal-appt.confirmed { background: #d1fae5; color: #065f46; border-left: 3px solid #10b981; }
.cal-appt.cancelled { background: #f3f4f6; color: #9ca3af; border-left: 3px solid #d1d5db; opacity: .6; }

.week-nav-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid #e5e7eb; background: #f9fafb; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #6b7280; transition: .15s; }
.week-nav-btn:hover  { background: #ede9fe; border-color: #6366f1; color: #6366f1; }
.week-nav-btn.disabled { opacity: .35; pointer-events: none; }
</style>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">{{ 'client.title'|trans }}</h4>
        <p class="text-muted small mb-0">{{ 'client.welcome'|trans }}, {{ app.user.name }}</p>
    </div>
    {% if has_appointments %}
        <a href="{{ path('client_appointments') }}" class="btn btn-outline-secondary">
            <i class="bi bi-list-ul me-1"></i>{{ 'appt.view_all'|trans }}
        </a>
    {% endif %}
</div>

{% if not has_appointments %}
    <div class="card p-5 text-center">
        <div style="font-size:3rem; color:#d1d5db"><i class="bi bi-calendar-x"></i></div>
        <h5 class="fw-semibold mt-3 mb-1">{{ 'client.no_appointments'|trans }}</h5>
        <p class="text-muted small mb-3">{{ 'client.no_appointments_text'|trans }}</p>
        <a href="{{ path('client_organizations') }}" class="btn btn-primary mx-auto" style="width:fit-content">
            <i class="bi bi-search me-1"></i>{{ 'client.find_organizations'|trans }}
        </a>
    </div>
{% else %}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <button class="week-nav-btn" id="prevWeek"><i class="bi bi-chevron-left"></i></button>
        <span class="fw-semibold" id="weekLabel" style="min-width:160px;text-align:center"></span>
        <button class="week-nav-btn" id="nextWeek"><i class="bi bi-chevron-right"></i></button>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" id="todayBtn">{{ 'common.today'|trans }}</button>
        <button class="btn btn-sm btn-outline-secondary" id="collapseBtn">
            <i class="bi bi-arrows-collapse me-1"></i><span id="collapseBtnLabel">{{ 'dashboard.collapse'|trans }}</span>
        </button>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary filter-btn active" data-filter="all">{{ 'common.all'|trans }}</button>
            <button type="button" class="btn btn-outline-warning filter-btn" data-filter="pending">{{ 'status.pending'|trans }}</button>
            <button type="button" class="btn btn-outline-success filter-btn" data-filter="confirmed">{{ 'status.confirmed'|trans }}</button>
            <button type="button" class="btn btn-outline-secondary filter-btn" data-filter="cancelled">{{ 'status.cancelled'|trans }}</button>
        </div>
    </div>
</div>

<div class="cal-wrap card p-0" style="overflow:hidden">
    <div id="calInner" class="cal-wrap" style="padding:0"></div>
</div>

<div class="modal fade" id="apptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-1">
                <div>
                    <h5 class="modal-title fw-bold mb-0" id="modalOrg"></h5>
                    <div class="text-muted small" id="modalMeta"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <div id="modalBody"></div>
            </div>
            <div class="modal-footer border-0 pt-0" id="modalFooter"></div>
        </div>
    </div>
</div>

<form method="post" id="cancelForm" style="display:none">
    <input type="hidden" name="cancellation_note" id="cancelNote">
</form>

{% endif %}
{% endblock %}

{% block scripts %}
{% if has_appointments %}
{% set dayAbbr = [
    'cal.day.0'|trans, 'cal.day.1'|trans, 'cal.day.2'|trans,
    'cal.day.3'|trans, 'cal.day.4'|trans, 'cal.day.5'|trans, 'cal.day.6'|trans
] %}
{% set monthNames = [
    'cal.month.0'|trans, 'cal.month.1'|trans, 'cal.month.2'|trans,
    'cal.month.3'|trans, 'cal.month.4'|trans, 'cal.month.5'|trans,
    'cal.month.6'|trans, 'cal.month.7'|trans, 'cal.month.8'|trans,
    'cal.month.9'|trans, 'cal.month.10'|trans, 'cal.month.11'|trans
] %}
<script>
const appointments  = {{ appointments_json|raw }};
const cancelUrlTpl  = `{{ path('client_cancel', {id: '__ID__'}) }}`;
const cancelUrl     = id => cancelUrlTpl.replace('__ID__', id);
const icalUrlTpl    = `{{ path('appointment_ical', {id: '__ID__'}) }}`;
const icalUrl       = id => icalUrlTpl.replace('__ID__', id);

const DAY_ABBR    = {{ dayAbbr|json_encode|raw }};
const MONTH_NAMES = {{ monthNames|json_encode|raw }};

const T = {
    pending:           {{ 'status.pending'|trans|json_encode|raw }},
    confirmed:         {{ 'status.confirmed'|trans|json_encode|raw }},
    cancelled:         {{ 'status.cancelled'|trans|json_encode|raw }},
    close:             {{ 'common.close'|trans|json_encode|raw }},
    cancel:            {{ 'common.cancel'|trans|json_encode|raw }},
    cancelTitle:       {{ 'business.cancel.title'|trans|json_encode|raw }},
    cancelNoteLabel:   {{ 'business.cancel.note_label'|trans|json_encode|raw }},
    cancelNotePlaceholder: {{ 'business.cancel.note_placeholder'|trans|json_encode|raw }},
    cancelYes:         {{ 'business.cancel.yes'|trans|json_encode|raw }},
    cancelKeep:        {{ 'business.cancel.keep'|trans|json_encode|raw }},
    noApptsWeek:       {{ 'client.no_this_week'|trans|json_encode|raw }},
    addToCalendar:     {{ 'cal.add_to_calendar'|trans|json_encode|raw }},
    addIcal:           {{ 'cal.add_ical'|trans|json_encode|raw }},
    addGoogle:         {{ 'cal.add_google'|trans|json_encode|raw }},
    collapse:          {{ 'dashboard.collapse'|trans|json_encode|raw }},
    expand:            {{ 'dashboard.expand'|trans|json_encode|raw }},
};

let windowStart   = startOfWeek();
let activeFilter  = 'all';
let collapseEmpty = false;

function startOfToday() { const d = new Date(); d.setHours(0,0,0,0); return d; }
function startOfWeek()  {
    const d = startOfToday();
    const diff = d.getDay() === 0 ? -6 : 1 - d.getDay();
    d.setDate(d.getDate() + diff);
    return d;
}
function addDays(d, n) { const r = new Date(d); r.setDate(r.getDate() + n); return r; }
function isoDate(d)    { return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); }

function visibleAppointments() {
    const appts = activeFilter === 'all' ? appointments : appointments.filter(a => a.status === activeFilter);
    const days  = Array.from({length: 7}, (_, i) => isoDate(addDays(windowStart, i)));
    return appts.filter(a => days.includes(a.date));
}

function renderCalendar() {
    const today = startOfToday();
    const days  = Array.from({length: 7}, (_, i) => addDays(windowStart, i));

    const months = new Set(days.map(d => MONTH_NAMES[d.getMonth()] + ' ' + d.getFullYear()));
    document.getElementById('weekLabel').textContent = [...months].join(' / ');
    document.getElementById('prevWeek').classList.toggle('disabled', windowStart <= today);

    const weekAppts = visibleAppointments();

    const timesSet = new Set(weekAppts.map(a => a.time));
    const times    = [...timesSet].sort();

    const idx = {};
    weekAppts.forEach(a => {
        (idx[a.date] ??= {})[a.time] ??= [];
        idx[a.date][a.time].push(a);
    });

    const visibleDays = collapseEmpty
        ? days.filter(d => weekAppts.some(a => a.date === isoDate(d)))
        : days;
    const colspan = visibleDays.length + 1;

    let html = '<table class="cal-table w-100"><thead><tr>';
    html += '<th class="cal-time-th"></th>';
    visibleDays.forEach(d => {
        const isToday = isoDate(d) === isoDate(today);
        html += `<th class="cal-day-th${isToday ? ' today' : ''}">
            <div class="d-name">${DAY_ABBR[d.getDay()]}</div>
            <div class="d-num">${d.getDate()}</div>
        </th>`;
    });
    html += '</tr></thead><tbody>';

    if (times.length === 0) {
        html += `<tr><td colspan="${colspan}" class="text-center text-muted py-5 small">
            <i class="bi bi-calendar-check me-1"></i>${T.noApptsWeek}
        </td></tr>`;
    } else {
        times.forEach(ts => {
            html += `<tr><td class="cal-time-td">${ts}</td>`;
            visibleDays.forEach(d => {
                const cell = idx[isoDate(d)]?.[ts] || [];
                let pills = '';
                cell.forEach(a => {
                    pills += `<div class="cal-appt ${a.status}" onclick="openModal(${a.id})" title="${a.org_name}">${a.org_name}</div>`;
                });
                html += `<td class="cal-day-td">${pills}</td>`;
            });
            html += '</tr>';
        });
    }

    html += '</tbody></table>';
    document.getElementById('calInner').innerHTML = html;
}

function openModal(id) {
    const a = appointments.find(x => x.id === id);
    if (!a) return;

    const statusLabel = { pending: T.pending, confirmed: T.confirmed, cancelled: T.cancelled };
    const statusClass = { pending: 'warning', confirmed: 'success', cancelled: 'secondary' };

    document.getElementById('modalOrg').textContent  = a.org_name;
    document.getElementById('modalMeta').textContent = a.date + ' · ' + a.time;

    let body = `<div class="d-flex flex-column gap-2 small">`;
    if (a.employee) {
        body += `<div><i class="bi bi-person-badge me-2 text-muted"></i>${a.employee}`;
        if (a.emp_role) body += ` <span class="text-muted">(${a.emp_role})</span>`;
        body += `</div>`;
        const phone = a.emp_phone || a.org_phone;
        if (phone) {
            const isEmail = phone.includes('@');
            body += `<div><i class="bi bi-${isEmail ? 'envelope' : 'telephone'} me-2 text-muted"></i><a href="${isEmail ? 'mailto' : 'tel'}:${phone}" class="text-decoration-none">${phone}</a></div>`;
        }
    }
    if (a.notes) body += `<div><i class="bi bi-chat-left-text me-2 text-muted"></i>${a.notes}</div>`;
    body += `<div><span class="badge bg-${statusClass[a.status]}-subtle text-${statusClass[a.status]}-emphasis border border-${statusClass[a.status]}-subtle">${statusLabel[a.status]}</span></div>`;
    if (a.cancel_note) body += `<div class="mt-1 px-3 py-2 rounded-3" style="background:#fef3c7;color:#92400e;border-left:3px solid #f59e0b"><i class="bi bi-info-circle me-1"></i>${a.cancel_note}</div>`;
    body += `</div>`;
    document.getElementById('modalBody').innerHTML = body;

    let footer = `<button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">${T.close}</button>`;
    if (a.status === 'confirmed') {
        footer += buildCalendarBtn(a);
    }
    if (a.status === 'pending') {
        footer += `<button type="button" class="btn btn-danger btn-sm" onclick="doCancel(${a.id},'${a.org_name.replace(/'/g,"\\'")}')">
            <i class="bi bi-x-lg me-1"></i>${T.cancel}</button>`;
    }
    document.getElementById('modalFooter').innerHTML = footer;

    bootstrap.Modal.getOrCreateInstance(document.getElementById('apptModal')).show();
}

function buildCalendarBtn(a) {
    return `<button type="button" class="btn btn-outline-success btn-sm" onclick="addToCalendar(${a.id})">
        <i class="bi bi-calendar-plus me-1"></i>${T.addToCalendar}
    </button>`;
}

function addToCalendar(id) {
    const a = appointments.find(x => x.id === id);
    if (!a) return;
    const ua = navigator.userAgent;
    const isIOS       = /iPhone|iPad|iPod/i.test(ua);
    const isMacSafari = /Macintosh/i.test(ua) && /Safari/i.test(ua) && !/Chrome|CriOS|FxiOS|Edg/i.test(ua);
    if (isIOS || isMacSafari) {
        window.location.href = icalUrl(id);
    } else {
        window.open(googleCalUrl(a), '_blank', 'noopener');
    }
}

function googleCalUrl(a) {
    const [y, mo, d] = a.date.split('-');
    const [h, mi]    = a.time.split(':');
    const startDt    = `${y}${mo}${d}T${h}${mi}00`;
    const endH       = String(parseInt(h, 10) + 1).padStart(2, '0');
    const endDt      = `${y}${mo}${d}T${endH}${mi}00`;
    const text       = encodeURIComponent((a.org_name || '') + (a.employee ? ' — ' + a.employee : ''));
    const details    = encodeURIComponent(a.notes || '');
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${text}&dates=${startDt}/${endDt}&details=${details}`;
}

async function doCancel(id, orgName) {
    bootstrap.Modal.getInstance(document.getElementById('apptModal'))?.hide();
    const result = await Swal.fire({
        title: T.cancelTitle,
        html: `<p class="text-muted mb-0">${orgName}</p>`,
        input: 'textarea',
        inputLabel: T.cancelNoteLabel,
        inputPlaceholder: T.cancelNotePlaceholder,
        inputAttributes: { rows: 3, style: 'resize:none;font-size:.9rem' },
        showCancelButton: true,
        confirmButtonText: T.cancelYes,
        confirmButtonColor: '#dc3545',
        cancelButtonText: T.cancelKeep,
        reverseButtons: true,
        focusCancel: true,
    });
    if (result.isConfirmed) {
        const form = document.getElementById('cancelForm');
        form.action = cancelUrl(id);
        document.getElementById('cancelNote').value = result.value || '';
        form.submit();
    }
}

document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        activeFilter = this.dataset.filter;
        renderCalendar();
    });
});
document.getElementById('prevWeek').addEventListener('click', () => {
    const today = startOfToday();
    windowStart = addDays(windowStart, -7);
    if (windowStart < today) windowStart = startOfWeek();
    renderCalendar();
});
document.getElementById('nextWeek').addEventListener('click', () => {
    windowStart = addDays(windowStart, 7);
    renderCalendar();
});
document.getElementById('todayBtn').addEventListener('click', () => {
    windowStart = startOfWeek();
    renderCalendar();
});
document.getElementById('collapseBtn').addEventListener('click', () => {
    collapseEmpty = !collapseEmpty;
    const btn   = document.getElementById('collapseBtn');
    const label = document.getElementById('collapseBtnLabel');
    label.textContent = collapseEmpty ? T.expand : T.collapse;
    btn.querySelector('i').className = collapseEmpty ? 'bi bi-arrows-expand me-1' : 'bi bi-arrows-collapse me-1';
    renderCalendar();
});

renderCalendar();
</script>
{% endif %}
{% endblock %}
