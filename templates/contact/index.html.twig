{% extends 'base.html.twig' %}
{% block title %}{{ 'contact.title'|trans }} — Grafira{% endblock %}

{% block body %}
<div class="row justify-content-center g-4 py-2">

    {# ── Info column ── #}
    <div class="col-lg-4 col-md-5">
        <div class="card h-100 border-0 shadow-sm p-4">
            <div class="mb-3" style="font-size:2.4rem; color:#6366f1"><i class="bi bi-envelope-heart"></i></div>
            <h4 class="fw-bold mb-1">{{ 'contact.info_title'|trans }}</h4>
            <p class="text-muted small mb-4">{{ 'contact.info_text'|trans }}</p>

            <div class="d-flex flex-column gap-3 small">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:10px;background:#ede9fe;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        <i class="bi bi-envelope text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.05em">{{ 'contact.label_email'|trans }}</div>
                        <a href="mailto:info@grafira.com" class="fw-semibold text-decoration-none text-dark">info@grafira.com</a>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div style="width:36px;height:36px;border-radius:10px;background:#d1fae5;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        <i class="bi bi-clock text-success"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.05em">{{ 'contact.label_hours'|trans }}</div>
                        <span class="fw-semibold">{{ 'contact.hours_value'|trans }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Form column ── #}
    <div class="col-lg-6 col-md-7">
        <div class="card border-0 shadow-sm p-4">
            <h4 class="fw-bold mb-1">{{ 'contact.form_title'|trans }}</h4>
            <p class="text-muted small mb-4">{{ 'contact.form_subtitle'|trans }}</p>

            {% if sent %}
                <div class="alert alert-success d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill"></i>
                    {{ 'contact.success'|trans }}
                </div>
            {% else %}
                {% if error %}
                    <div class="alert alert-danger small">{{ error }}</div>
                {% endif %}

                <form method="post" novalidate>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">{{ 'contact.field_name'|trans }} <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="{{ 'contact.placeholder_name'|trans }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">{{ 'contact.field_email'|trans }} <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" placeholder="{{ 'contact.placeholder_email'|trans }}" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">{{ 'contact.field_message'|trans }} <span class="text-danger">*</span></label>
                        <textarea name="message" class="form-control" rows="5" placeholder="{{ 'contact.placeholder_message'|trans }}" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send me-1"></i>{{ 'contact.submit'|trans }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}
