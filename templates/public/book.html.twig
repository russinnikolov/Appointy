{% extends 'base.html.twig' %}
{% from 'macros.html.twig' import time_select %}
{% block title %}Book with {{ employee.name }} — Appointy{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <a href="{{ path('public_organization', {id: organization.id}) }}" class="btn btn-link text-muted ps-0 mb-3 small">
            <i class="bi bi-arrow-left me-1"></i>Back to {{ organization.name }}
        </a>

        <div class="card p-4 p-md-5">
            {# Employee header #}
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:52px;height:52px;background:#ede9fe;color:#6366f1;font-size:1.4rem">
                    <i class="bi bi-person"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">Book with {{ employee.name }}</h5>
                    <p class="text-muted small mb-0">
                        {% if employee.role %}{{ employee.role }} · {% endif %}{{ organization.name }}
                    </p>
                </div>
            </div>

            {% if error %}
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-circle me-1"></i>{{ error }}
                </div>
            {% endif %}

            <form method="post" novalidate>
                <p class="fw-semibold small text-uppercase text-muted mb-3">Your Details</p>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" name="guest_name" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('guest_name') }}"
                               required placeholder="John Doe">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small">Phone Number <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                        <input type="tel" name="guest_phone" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('guest_phone') }}"
                               required placeholder="+1 555 000 0000">
                    </div>
                </div>

                <hr class="mb-4">
                <p class="fw-semibold small text-uppercase text-muted mb-3">Appointment</p>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Date <span class="text-danger">*</span></label>
                    <input type="date" name="date" class="form-control"
                           min="{{ "now"|date("Y-m-d") }}" required
                           value="{{ app.request.request.get('date') }}">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Time <span class="text-danger">*</span></label>
                    {{ time_select('time', app.request.request.get('time', '09:00')) }}
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold small">Notes <span class="text-muted">(optional)</span></label>
                    <textarea name="notes" class="form-control" rows="2"
                              placeholder="Any special requests…">{{ app.request.request.get('notes') }}</textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-calendar-check me-1"></i>Book Appointment
                </button>

                <p class="text-center text-muted small mt-3 mb-0">
                    No account needed. We'll contact you by phone to confirm.
                </p>
            </form>
        </div>
    </div>
</div>
{% endblock %}
