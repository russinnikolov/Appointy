{% extends 'base.html.twig' %}
{% block title %}{{ 'public.booking_confirmed.title'|trans }} — Grafira{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card p-4 p-md-5 text-center">
            <div style="font-size:3.5rem; color:#059669"><i class="bi bi-check-circle-fill"></i></div>
            <h4 class="fw-bold mt-3 mb-1">{{ 'public.booking_confirmed.booked'|trans }}</h4>
            <p class="text-muted mb-4">{{ 'public.booking_confirmed.text'|trans({'%name%': organization|localized('name')}) }}</p>

            <div class="bg-light rounded-3 p-3 text-start mb-4">
                <div class="row g-2 small">
                    <div class="col-5 text-muted fw-semibold">{{ 'public.booking_confirmed.org'|trans }}</div>
                    <div class="col-7">{{ organization|localized('name') }}</div>

                    <div class="col-5 text-muted fw-semibold">{{ 'public.booking_confirmed.employee'|trans }}</div>
                    <div class="col-7">
                        {% if employee %}
                            {{ employee.name }}{% if employee.role %} ({{ employee.role }}){% endif %}
                        {% else %}
                            <span class="text-muted">{{ 'book.any_employee'|trans }}</span>
                        {% endif %}
                    </div>

                    <div class="col-5 text-muted fw-semibold">{{ 'common.date'|trans }}</div>
                    <div class="col-7">{{ appointment.appointmentDate|date('D, M j Y') }}</div>

                    <div class="col-5 text-muted fw-semibold">{{ 'public.booking_confirmed.time'|trans }}</div>
                    <div class="col-7">{{ appointment.appointmentTime|date('H:i') }}</div>

                    <div class="col-5 text-muted fw-semibold">{{ 'public.booking_confirmed.your_name'|trans }}</div>
                    <div class="col-7">{{ appointment.guestName }}</div>

                    <div class="col-5 text-muted fw-semibold">{{ 'public.booking_confirmed.phone'|trans }}</div>
                    <div class="col-7">{{ appointment.guestPhone }}</div>
                </div>
            </div>

            {% set calDate    = appointment.appointmentDate|date('Ymd') %}
            {% set calTime    = appointment.appointmentTime|date('Hi') %}
            {% set dur        = appointment.durationMinutes ?? 60 %}
            {% set startMins  = appointment.appointmentTime|date('G') * 60 + appointment.appointmentTime|date('i') %}
            {% set endMins    = startMins + dur %}
            {% set endH       = ((endMins / 60)|round(0, 'floor')) % 24 %}
            {% set endM       = endMins % 60 %}
            {% set endTime    = (endH < 10 ? '0' ~ endH : '' ~ endH) ~ (endM < 10 ? '0' ~ endM : '' ~ endM) %}
            {% set calTitle   = ('public.booking_confirmed.booked'|trans) ~ ' — ' ~ (organization|localized('name')) %}
            {% set calDetails = appointment.guestName %}
            {% set calUrl     = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
                ~ '&text='    ~ calTitle|url_encode
                ~ '&dates='   ~ calDate ~ 'T' ~ calTime ~ '00/' ~ calDate ~ 'T' ~ endTime ~ '00'
                ~ '&details=' ~ calDetails|url_encode
                ~ (organization.fullAddress ? ('&location=' ~ organization.fullAddress|url_encode) : '') %}
            <a href="{{ calUrl }}" target="_blank" rel="noopener" class="btn btn-primary w-100 mb-2">
                <i class="bi bi-calendar-plus me-1"></i>{{ 'book.add_to_google_calendar'|trans }}
            </a>
            <a href="{{ path('public_organizations') }}" class="btn btn-outline-secondary w-100">
                <i class="bi bi-building me-1"></i>{{ 'public.booking_confirmed.browse'|trans }}
            </a>
        </div>
    </div>
</div>
{% endblock %}
