{% extends 'base.html.twig' %}
{% block title %}{{ 'public.orgs.title'|trans }} — Grafira{% endblock %}

{% block head %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
    #orgMap { height: 340px; border-radius: 12px; border: 1px solid #e5e7eb; }
    .org-card { transition: .15s; cursor: pointer; }
    .org-card:hover { box-shadow: 0 4px 20px rgba(99,102,241,.15) !important; }
    .org-card.highlighted { box-shadow: 0 0 0 2px #6366f1, 0 4px 20px rgba(99,102,241,.2) !important; }
    .fav-btn { line-height:1; background:none; border:none; padding:0; cursor:pointer; }
    .fav-btn .bi-star      { color:#9ca3af; }
    .fav-btn .bi-star-fill { color:#f59e0b; }
    .fav-btn:hover .bi-star { color:#f59e0b; }
</style>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">{{ 'public.orgs.title'|trans }}</h4>
        <p class="text-muted small mb-0">{{ 'public.orgs.subtitle'|trans }}</p>
    </div>
</div>

<form method="get" class="mb-4" id="searchForm">
    <div class="input-group">
        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
        <input type="text" name="q" id="searchInput" class="form-control border-start-0 ps-0"
               value="{{ search }}" placeholder="{{ 'org.search_placeholder'|trans }}" autofocus>
        <button type="submit" class="btn btn-primary px-4">{{ 'common.search'|trans }}</button>
        {% if search %}
            <a href="{{ path('public_organizations') }}" class="btn btn-outline-secondary">{{ 'common.clear'|trans }}</a>
        {% endif %}
    </div>
</form>

{% set mappable = organizations|filter(o => o.latitude is not null and o.longitude is not null) %}
{% if mappable is not empty %}
<div id="orgMap" class="mb-4"></div>
{% endif %}

{% if organizations is empty %}
    <div class="card p-5 text-center">
        <div style="font-size:3rem; color:#d1d5db"><i class="bi bi-building-slash"></i></div>
        <h5 class="fw-semibold mt-3 mb-1">{{ 'org.no_results'|trans }}</h5>
        <p class="text-muted small">{{ 'org.no_results_text'|trans }}</p>
    </div>
{% else %}
    <div class="row g-3" id="orgList">
        {% for org in organizations %}
            {% set isFav = is_granted('ROLE_CLIENT') and app.user.isFavouriteOrganization(org) %}
            <div class="col-md-6 col-lg-4 org-item" id="org-{{ org.id }}">
                <a href="{{ path('public_organization', {id: org.id}) }}" class="text-decoration-none">
                    <div class="card h-100 p-3 org-card position-relative">
                        {% if is_granted('ROLE_CLIENT') %}
                            <button class="fav-btn position-absolute top-0 end-0 m-2"
                                    data-org-id="{{ org.id }}"
                                    data-toggle-url="{{ path('client_favourite_toggle', {id: org.id}) }}"
                                    title="{{ isFav ? 'fav.remove'|trans : 'fav.add'|trans }}"
                                    onclick="event.preventDefault();event.stopPropagation()">
                                <i class="bi bi-star{{ isFav ? '-fill' : '' }}" style="font-size:1.2rem"></i>
                            </button>
                        {% endif %}
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            {% if org.logoFilename %}
                                <img src="/uploads/logos/{{ org.logoFilename }}" alt="{{ org.name }}"
                                     class="rounded-circle flex-shrink-0"
                                     style="width:42px;height:42px;object-fit:cover;border:1px solid #e5e7eb">
                            {% else %}
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:42px;height:42px;background:#ede9fe;color:#6366f1;font-size:1.2rem">
                                    <i class="bi bi-building"></i>
                                </div>
                            {% endif %}
                            {% if org.category %}
                                <span class="badge bg-light text-secondary border small">{{ ('category.' ~ org.category)|trans }}</span>
                            {% endif %}
                        </div>
                        <h6 class="fw-bold mb-1 text-dark">{{ org|localized('name') }}</h6>
                        {% if org.fullAddress or org.address %}
                            {% set addrText = org.fullAddress ?: org.address %}
                            {% set mapsQuery = org.latitude and org.longitude
                                ? org.latitude ~ ',' ~ org.longitude
                                : addrText %}
                            <p class="text-muted small mb-1">
                                <i class="bi bi-geo-alt me-1"></i>
                                <a href="https://www.google.com/maps/search/?api=1&query={{ mapsQuery|url_encode }}"
                                   target="_blank" rel="noopener" class="text-muted text-decoration-none link-hover">{{ addrText }}</a>
                            </p>
                        {% endif %}
                        {% if org.description %}
                            <p class="text-muted small mb-2 flex-grow-1"
                               style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                                {{ org|localized('description') }}
                            </p>
                        {% endif %}
                        <div class="mt-auto pt-2">
                            <span class="text-primary small fw-semibold">
                                <i class="bi bi-people me-1"></i>
                                {{ org.employees|filter(e => e.isActive)|length }} {{ 'org.employees_count'|trans }}
                            </span>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}

{% block scripts %}
{% set mappable = organizations|filter(o => o.latitude is not null and o.longitude is not null) %}
{% if mappable is not empty %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const orgs = [
    {% for org in mappable %}
    {% set orgLocalName = org|localized('name') %}
    {
        id:        {{ org.id }},
        name:      {{ orgLocalName|json_encode|raw }},
        addr:      {{ (org.fullAddress ?: org.address ?: '')|json_encode|raw }},
        mapsQuery: {{ (org.latitude ~ ',' ~ org.longitude)|json_encode|raw }},
        lat:       {{ org.latitude }},
        lng:       {{ org.longitude }},
        url:       {{ path('public_organization', {id: org.id})|json_encode|raw }},
        logo:      {{ org.logoFilename ? ('"/uploads/logos/' ~ org.logoFilename ~ '"')|raw : 'null' }},
        viewBook:  {{ 'public.map.view_book'|trans|json_encode|raw }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
];

const map = L.map('orgMap');
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
}).addTo(map);

function makeIcon(org) {
    const initial = (org.name.trim()[0] || '?').toUpperCase();
    const inner = org.logo
        ? `<div style="
                width:44px;height:44px;border-radius:50%;
                background:url('${org.logo}') center/cover no-repeat #e0e7ff;
                border:3px solid #fff;
                box-shadow:0 2px 8px rgba(0,0,0,.25);
                flex-shrink:0;
           "></div>`
        : `<div style="
                width:44px;height:44px;border-radius:50%;
                background:#6366f1;color:#fff;
                display:flex;align-items:center;justify-content:center;
                font-weight:700;font-size:18px;font-family:sans-serif;
                border:3px solid #fff;
                box-shadow:0 2px 8px rgba(0,0,0,.25);
                flex-shrink:0;
           ">${initial}</div>`;

    const html = `
        <div style="display:flex;flex-direction:column;align-items:center;filter:drop-shadow(0 3px 6px rgba(0,0,0,.22))">
            ${inner}
            <div style="width:0;height:0;
                border-left:7px solid transparent;
                border-right:7px solid transparent;
                border-top:10px solid #fff;
                margin-top:-2px;
            "></div>
        </div>`;

    return L.divIcon({ className: '', html, iconSize: [44, 58], iconAnchor: [22, 58], popupAnchor: [0, -60] });
}

const markers = [];
const bounds  = [];

orgs.forEach(org => {
    const m = L.marker([org.lat, org.lng], { icon: makeIcon(org) })
        .addTo(map)
        .bindPopup(`
            <div style="min-width:200px">
                ${org.logo ? `<img src="${org.logo}" style="width:100%;height:80px;object-fit:cover;border-radius:8px;margin-bottom:8px;display:block">` : ''}
                <div style="font-weight:700;font-size:14px;margin-bottom:2px">${org.name}</div>
                ${org.addr ? `<div style="font-size:12px;color:#6b7280;margin-bottom:6px"><i class="bi bi-geo-alt"></i> <a href="https://www.google.com/maps/search/?api=1&query=${org.mapsQuery}" target="_blank" rel="noopener" style="color:#6b7280;text-decoration:none">${org.addr}</a></div>` : ''}
                <a href="${org.url}" style="display:block;text-align:center;background:#6366f1;color:#fff;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:13px;font-weight:600;margin-top:4px">${org.viewBook}</a>
            </div>
        `, { minWidth: 210 });

    m.on('click', () => {
        document.querySelectorAll('.org-card').forEach(c => c.classList.remove('highlighted'));
        const card = document.getElementById('org-' + org.id);
        if (card) {
            card.querySelector('.org-card').classList.add('highlighted');
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    });

    markers.push({ id: org.id, marker: m });
    bounds.push([org.lat, org.lng]);
});

if (bounds.length === 1) {
    map.setView(bounds[0], 14);
} else {
    map.fitBounds(bounds, { padding: [32, 32] });
}
</script>
{% endif %}
{% if is_granted('ROLE_CLIENT') %}
<script>
document.querySelectorAll('.fav-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const url = btn.dataset.toggleUrl;
        try {
            const res  = await fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();
            const icon = btn.querySelector('i');
            if (data.favourited) {
                icon.className = 'bi bi-star-fill';
                icon.style.color = '#f59e0b';
                btn.title = {{ 'fav.remove'|trans|json_encode|raw }};
            } else {
                icon.className = 'bi bi-star';
                icon.style.color = '';
                btn.title = {{ 'fav.add'|trans|json_encode|raw }};
            }
        } catch(e) { console.error(e); }
    });
});
</script>
{% endif %}
{% endblock %}
