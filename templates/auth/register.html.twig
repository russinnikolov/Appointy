{% extends 'base.html.twig' %}
{% block title %}Register — Appointy{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <div class="card p-4 p-md-5">
            <div class="text-center mb-4">
                <span style="font-size:2.5rem; color:#6366f1"><i class="bi bi-person-plus-fill"></i></span>
                <h4 class="fw-bold mt-2 mb-0">Create your account</h4>
                <p class="text-muted small">Choose your account type to get started</p>
            </div>

            {# Account type tabs #}
            <ul class="nav nav-pills nav-fill mb-4 bg-light rounded-3 p-1" id="typeTabs">
                <li class="nav-item">
                    <button class="nav-link rounded-3 fw-semibold {{ type != 'business' ? 'active' : '' }}"
                            id="tab-client" type="button" onclick="switchType('client')">
                        <i class="bi bi-person me-1"></i>Client
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-3 fw-semibold {{ type == 'business' ? 'active' : '' }}"
                            id="tab-business" type="button" onclick="switchType('business')">
                        <i class="bi bi-building me-1"></i>Business
                    </button>
                </li>
            </ul>

            {% if error %}
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-circle me-1"></i>{{ error }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('register') }}" novalidate id="regForm">
                <input type="hidden" name="type" id="typeInput" value="{{ type }}">

                {# Personal details #}
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" name="name" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('name') }}" required placeholder="John Doe">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Email address <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" name="email" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('email') }}" required placeholder="you@example.com">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Phone</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                        <input type="tel" name="phone" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('phone') }}" placeholder="+1 555 000 0000">
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Password <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control" required
                               placeholder="Min. 8 characters" autocomplete="new-password">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Confirm Password <span class="text-danger">*</span></label>
                        <input type="password" name="confirm_password" class="form-control" required
                               placeholder="Repeat password" autocomplete="new-password">
                    </div>
                </div>

                {# Business-only fields #}
                <div id="businessFields" class="{{ type != 'business' ? 'd-none' : '' }}">
                    <hr class="mb-4">
                    <p class="fw-semibold small text-muted text-uppercase letter-spacing mb-3">
                        <i class="bi bi-building me-1"></i>Organization Details
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Organization Name <span class="text-danger">*</span></label>
                        <input type="text" name="org_name" class="form-control"
                               value="{{ app.request.request.get('org_name') }}" placeholder="Acme Barbershop">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Category</label>
                            <select name="org_category" class="form-select">
                                <option value="">— select —</option>
                                {% for cat in ['Barbershop', 'Beauty Salon', 'Dental', 'Medical', 'Fitness', 'Spa', 'Legal', 'Consulting', 'Other'] %}
                                    <option value="{{ cat }}"
                                        {{ app.request.request.get('org_category') == cat ? 'selected' : '' }}>
                                        {{ cat }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Organization Phone</label>
                            <input type="tel" name="org_phone" class="form-control"
                                   value="{{ app.request.request.get('org_phone') }}" placeholder="+1 555 000 0000">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Organization Email</label>
                        <input type="email" name="org_email" class="form-control"
                               value="{{ app.request.request.get('org_email') }}" placeholder="contact@yourbusiness.com">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Address</label>
                        <input type="text" name="org_address" class="form-control"
                               value="{{ app.request.request.get('org_address') }}" placeholder="123 Main St, City">
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Description</label>
                        <textarea name="org_description" class="form-control" rows="2"
                                  placeholder="Tell clients what you offer...">{{ app.request.request.get('org_description') }}</textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-person-check me-1"></i>Create Account
                </button>
            </form>

            <hr class="my-4">
            <p class="text-center text-muted small mb-0">
                Already have an account?
                <a href="{{ path('login') }}" class="fw-semibold text-decoration-none" style="color:#6366f1">Sign in</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function switchType(type) {
    document.getElementById('typeInput').value = type;
    document.getElementById('tab-client').classList.toggle('active', type === 'client');
    document.getElementById('tab-business').classList.toggle('active', type === 'business');
    document.getElementById('businessFields').classList.toggle('d-none', type !== 'business');
}
</script>
{% endblock %}
