{% extends 'base.html.twig' %}
{% block title %}{{ 'nav.register'|trans }} — Grafira{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <div class="card p-4 p-md-5">
            <div class="text-center mb-4">
                <span style="font-size:2.5rem; color:#6366f1"><i class="bi bi-person-plus-fill"></i></span>
                <h4 class="fw-bold mt-2 mb-0">{{ 'auth.register.title'|trans }}</h4>
                <p class="text-muted small">{{ 'auth.register.subtitle'|trans }}</p>
            </div>

            <ul class="nav nav-pills nav-fill mb-4 bg-light rounded-3 p-1" id="typeTabs">
                <li class="nav-item">
                    <button class="nav-link rounded-3 fw-semibold {{ type != 'business' ? 'active' : '' }}"
                            id="tab-client" type="button" onclick="switchType('client')">
                        <i class="bi bi-person me-1"></i>{{ 'auth.register.client_tab'|trans }}
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-3 fw-semibold {{ type == 'business' ? 'active' : '' }}"
                            id="tab-business" type="button" onclick="switchType('business')">
                        <i class="bi bi-building me-1"></i>{{ 'auth.register.business_tab'|trans }}
                    </button>
                </li>
            </ul>

            {% if error %}
                <div class="alert alert-danger py-2 small">
                    <i class="bi bi-exclamation-circle me-1"></i>{{ error }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('register') }}" novalidate id="regForm">
                <input type="hidden" name="type" id="typeInput" value="{{ type }}">

                <div class="mb-3">
                    <label class="form-label fw-semibold small">{{ 'auth.register.full_name'|trans }} <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" name="name" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('name') }}" required placeholder="{{ 'placeholder.full_name'|trans }}">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">{{ 'auth.register.email'|trans }} <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" name="email" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('email') }}" required placeholder="{{ 'placeholder.email'|trans }}">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">{{ 'auth.register.phone'|trans }}</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                        <input type="tel" name="phone" class="form-control border-start-0 ps-0"
                               value="{{ app.request.request.get('phone') }}" placeholder="{{ 'placeholder.phone'|trans }}"
                               pattern="^\+?[\d\s\-\.\(\)]{7,20}$" title="{{ 'validation.phone'|trans }}">
                    </div>
                </div>

                <div id="clientMessagingFields" class="{{ type == 'business' ? 'd-none' : '' }} mb-3">
                    <label class="form-label fw-semibold small d-block">{{ 'auth.register.messaging_apps'|trans }}</label>
                    <div class="d-flex flex-wrap gap-2">
                        {% for app in ['whatsapp', 'telegram', 'viber', 'sms'] %}
                        <div class="form-check form-check-inline me-0">
                            <input class="form-check-input" type="checkbox" name="messaging_apps[]"
                                   value="{{ app }}" id="reg_app_{{ app }}"
                                   {{ app in (app.request.request.all('messaging_apps') ?? []) ? 'checked' : '' }}>
                            <label class="form-check-label small d-flex align-items-center gap-1" for="reg_app_{{ app }}">
                                {% if app == 'whatsapp' %}<i class="bi bi-whatsapp" style="color:#25D366"></i>{% endif %}
                                {% if app == 'telegram' %}<i class="bi bi-telegram" style="color:#229ED9"></i>{% endif %}
                                {% if app == 'viber' %}<i class="bi bi-phone" style="color:#7360f2"></i>{% endif %}
                                {% if app == 'sms' %}<i class="bi bi-chat-dots" style="color:#6b7280"></i>{% endif %}
                                {{ ('messaging.' ~ app)|trans }}
                            </label>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">{{ 'auth.register.password'|trans }} <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control" required
                               placeholder="{{ 'common.min_8_chars'|trans }}" autocomplete="new-password">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">{{ 'auth.register.confirm_password'|trans }} <span class="text-danger">*</span></label>
                        <input type="password" name="confirm_password" class="form-control" required
                               placeholder="{{ 'auth.register.repeat_password'|trans }}" autocomplete="new-password">
                    </div>
                </div>

                <div id="businessFields" class="{{ type != 'business' ? 'd-none' : '' }}">
                    <hr class="mb-4">
                    <p class="fw-semibold small text-muted text-uppercase mb-3">
                        <i class="bi bi-building me-1"></i>{{ 'auth.register.org_section'|trans }}
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">{{ 'auth.register.org_name'|trans }} <span class="text-danger">*</span></label>
                        <input type="text" name="org_name" class="form-control"
                               value="{{ app.request.request.get('org_name') }}" placeholder="{{ 'placeholder.org_name'|trans }}">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">{{ 'auth.register.org_category'|trans }}</label>
                            <select name="org_category" class="form-select">
                                <option value="">{{ 'common.select'|trans }}</option>
                                {% for cat in ['Barbershop', 'Beauty Salon', 'Dental', 'Medical', 'Fitness', 'Spa', 'Legal', 'Consulting', 'Other'] %}
                                    <option value="{{ cat }}"
                                        {{ app.request.request.get('org_category') == cat ? 'selected' : '' }}>
                                        {{ ('category.' ~ cat)|trans }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">{{ 'auth.register.org_phone'|trans }}</label>
                            <input type="tel" name="org_phone" class="form-control"
                                   value="{{ app.request.request.get('org_phone') }}" placeholder="{{ 'placeholder.org_phone'|trans }}"
                                   pattern="^\+?[\d\s\-\.\(\)]{7,20}$" title="{{ 'validation.phone'|trans }}">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">{{ 'auth.register.org_email'|trans }}</label>
                        <input type="email" name="org_email" class="form-control"
                               value="{{ app.request.request.get('org_email') }}" placeholder="{{ 'placeholder.org_email'|trans }}">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">{{ 'auth.register.org_address'|trans }}</label>
                        <input type="text" name="org_address" class="form-control"
                               value="{{ app.request.request.get('org_address') }}" placeholder="{{ 'placeholder.address'|trans }}">
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">{{ 'common.city'|trans }}</label>
                            <input type="text" name="org_city" class="form-control"
                                   value="{{ app.request.request.get('org_city') }}" placeholder="{{ 'placeholder.city'|trans }}">
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">{{ 'common.zip'|trans }}</label>
                            <input type="text" name="org_zip" class="form-control"
                                   value="{{ app.request.request.get('org_zip') }}" placeholder="{{ 'placeholder.zip'|trans }}">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">{{ 'common.country'|trans }}</label>
                        <input type="text" name="org_country" class="form-control"
                               value="{{ app.request.request.get('org_country') }}" placeholder="{{ 'placeholder.country'|trans }}">
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small">{{ 'auth.register.org_description'|trans }}</label>
                        <textarea name="org_description" class="form-control" rows="2"
                                  placeholder="{{ 'auth.register.org_description_placeholder'|trans }}">{{ app.request.request.get('org_description') }}</textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-person-check me-1"></i>{{ 'auth.register.submit'|trans }}
                </button>
            </form>

            <hr class="my-4">
            <p class="text-center text-muted small mb-0">
                {{ 'auth.register.have_account'|trans }}
                <a href="{{ path('login') }}" class="fw-semibold text-decoration-none" style="color:#6366f1">{{ 'auth.register.sign_in'|trans }}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function switchType(type) {
    document.getElementById('typeInput').value = type;
    document.getElementById('tab-client').classList.toggle('active', type === 'client');
    document.getElementById('tab-business').classList.toggle('active', type === 'business');
    document.getElementById('businessFields').classList.toggle('d-none', type !== 'business');
    document.getElementById('clientMessagingFields').classList.toggle('d-none', type !== 'client');
}
</script>
{% endblock %}
