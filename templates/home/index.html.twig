{% extends 'base.html.twig' %}
{% block title %}Grafira — {{ 'home.hero.title'|trans }} {{ 'home.hero.title_accent'|trans }}{% endblock %}

{% block body %}
<div class="py-5 text-center">
    <div class="mb-3" style="font-size:4rem; color:#6366f1">
        <i class="bi bi-calendar-check-fill"></i>
    </div>
    <h1 class="display-5 fw-bold mb-3">
        {{ 'home.hero.title'|trans }} <span style="color:#6366f1">{{ 'home.hero.title_accent'|trans }}</span>
    </h1>
    <p class="lead text-muted mb-5 mx-auto" style="max-width:520px">
        {{ 'home.hero.subtitle'|trans }}
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="{{ path('register') }}" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-person-plus me-2"></i>{{ 'nav.register'|trans }}
        </a>
        <a href="{{ path('public_organizations') }}" class="btn btn-outline-primary btn-lg px-4">
            <i class="bi bi-search me-2"></i>{{ 'home.hero.find_btn'|trans }}
        </a>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center">
            <div class="mb-3" style="font-size:2rem; color:#6366f1"><i class="bi bi-search"></i></div>
            <h5 class="fw-semibold">{{ 'home.feature.find'|trans }}</h5>
            <p class="text-muted small mb-0">{{ 'home.feature.find_text'|trans }}</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center">
            <div class="mb-3" style="font-size:2rem; color:#6366f1"><i class="bi bi-calendar-plus"></i></div>
            <h5 class="fw-semibold">{{ 'home.feature.book'|trans }}</h5>
            <p class="text-muted small mb-0">{{ 'home.feature.book_text'|trans }}</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center">
            <div class="mb-3" style="font-size:2rem; color:#6366f1"><i class="bi bi-bell"></i></div>
            <h5 class="fw-semibold">{{ 'home.feature.track'|trans }}</h5>
            <p class="text-muted small mb-0">{{ 'home.feature.track_text'|trans }}</p>
        </div>
    </div>
</div>

<p class="text-center text-muted small mt-5">
    {{ 'home.have_account'|trans }}
    <a href="{{ path('login') }}" class="text-decoration-none fw-semibold" style="color:#6366f1">{{ 'nav.login'|trans }}</a>
</p>
{% endblock %}
