{% extends 'base.html.twig' %}
{% block title %}Appointy — Book Appointments Online{% endblock %}

{% block body %}
<div class="py-5 text-center">
    <div class="mb-3" style="font-size:4rem; color:#6366f1">
        <i class="bi bi-calendar-check-fill"></i>
    </div>
    <h1 class="display-5 fw-bold mb-3">
        Book appointments <span style="color:#6366f1">effortlessly</span>
    </h1>
    <p class="lead text-muted mb-5 mx-auto" style="max-width:520px">
        Connect with local organizations and schedule your next appointment in seconds.
        No phone calls, no waiting.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <a href="{{ path('register', {type: 'client'}) }}" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-person-plus me-2"></i>Get Started as Client
        </a>
        <a href="{{ path('register', {type: 'business'}) }}" class="btn btn-outline-primary btn-lg px-4">
            <i class="bi bi-building me-2"></i>Register Your Organization
        </a>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center">
            <div class="mb-3" style="font-size:2rem; color:#6366f1"><i class="bi bi-search"></i></div>
            <h5 class="fw-semibold">Find Organizations</h5>
            <p class="text-muted small mb-0">Browse a growing list of businesses offering appointment bookings.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center">
            <div class="mb-3" style="font-size:2rem; color:#6366f1"><i class="bi bi-calendar-plus"></i></div>
            <h5 class="fw-semibold">Book Instantly</h5>
            <p class="text-muted small mb-0">Pick a date and time that works for you — confirmed in real time.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 h-100 text-center">
            <div class="mb-3" style="font-size:2rem; color:#6366f1"><i class="bi bi-bell"></i></div>
            <h5 class="fw-semibold">Stay Updated</h5>
            <p class="text-muted small mb-0">Track every appointment status from your personal dashboard.</p>
        </div>
    </div>
</div>

<p class="text-center text-muted small mt-5">
    Already have an account?
    <a href="{{ path('login') }}" class="text-decoration-none fw-semibold" style="color:#6366f1">Log in</a>
</p>
{% endblock %}
